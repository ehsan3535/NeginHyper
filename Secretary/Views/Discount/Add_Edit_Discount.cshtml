@using Secretary.Models;
@model DiscountDto

<!-- BEGIN PAGE CONTENT -->
<!-- BEGIN BREADCRUMB -->
<div class="col-md-12">
    <div class="breadcrumb-box border shadow">
        <ul class="breadcrumb">
            <li><a href="ShowWorker"> سفارشات</a></li>
            <li><a href="ShowWorker">سفارشات جدید </a></li>
        </ul>
        <div class="breadcrumb-left">
            @DNTPersianUtils.Core.FriendlyPersianDateUtils.ToPersianDateTextify(DateTime.Now)
            <i class="icon-calendar"></i>
        </div><!-- /.breadcrumb-left -->
    </div><!-- /.breadcrumb-box -->
</div><!-- /.col-md-12 -->
<!-- END BREADCRUMB -->
<!-- START ADDWORKER -->
<div class="col-lg-12">
    <div class="portlet box border shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                @if (Model is not null)
                {
                    @if (Model.Id != Guid.Empty)
                    {
                        <h3 class="title">
                            <i class="icon-settings"></i>
                            ویرایش تخفیف
                        </h3>
                    }
                }
                else
                {
                    <h3 class="title">
                        <i class="icon-settings"></i>
                        افزودن تخفیف
                    </h3>
                }

            </div><!-- /.portlet-title -->
            <div class="buttons-box">
                <!-- <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                    <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                </a> -->
                <div class="code-modal hide">
                </div>
                <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                    <i class="icon-size-fullscreen"></i>
                </a>
                <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                    <i class="icon-arrow-up"></i>
                </a>
            </div><!-- /.buttons-box -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <form method="post" asp-action="Add_Edit_Discount" asp-controller="Discount">
                @if (Model != null)
                {
                    @if (Model.Id != Guid.Empty)
                    {
                        <input type="text" value="@Model.Id" asp-for="Id" class="form-control" hidden>
                    }
                }
                <div class="form-group">
                    <label>عنوان تخفیف :</label>
                    <div class="input-group">
                        <span class="input-group-addon">
                            <i class="icon-user"></i>
                        </span>
                        <input type="text" asp-for="Name" class="form-control" placeholder="عنوان">
                    </div><!-- /.input-group -->
                </div><!-- /.form-group -->
                <div class="form-group">
                    <label>  کد تخفیف:</label>
                    <div class="input-group">
                        <span class="input-group-addon">
                            <i class="icon-user"></i>
                        </span>
                        <input type="text" asp-for="Code" class="form-control" placeholder="کد تخفیف">
                    </div><!-- /.input-group -->
                </div><!-- /.form-group -->
                <div class="form-group">
                <label>  درصد تخفیف:</label>
                    <div class="input-group">
                        <span class="input-group-addon">
                            <i class="icon-user"></i>
                        </span>
                        <input type="number" asp-for="DiscountPercent" class="form-control" placeholder="درصد تخفیف">
                    </div><!-- /.input-group -->
                </div><!-- /.form-group -->
                <div class="row">
                    <button type="submit" class="btn btn-info btn-round btn-block">
                        <i class="icon-check"></i>
                        ثبت
                    </button>
                </div><!--end row-->
            </form>

        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
    <!-- END ADDWORKER -->
</div><!-- /.row -->
    </div>
</div>
<!-- /#page-content -->
<!-- END PAGE CONTENT -->
