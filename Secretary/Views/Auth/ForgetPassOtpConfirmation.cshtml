@{
    string Error = "";
    if (TempData["Error"] != null)
    {
        Error = TempData["Error"].ToString();
    }
}

<section class="log-space">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-11 col-md-11">

                <div class="row no-gutters position-relative log_rads">
                    <div class="col-lg-6 col-md-5 bg-cover" style="background:#213362 url(/assets/img/classroom5.jpg)no-repeat;">
                        <div class="lui_9okt6">
                            <div class="_loh_revu97">
                                <div id="reviews-login" dir="rtl">
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6 col-md-7 position-static p-4">
                        <form method="get" asp-action="ForgetPassOtpConfirmation">
                            <div class="log_wraps">
                                <div class="log__heads">
                                    <h4 class="mt-0 logs_title"><span class="theme-cl">کد تایید</span> را وارد کنید </h4>
                                </div>
                                <div class="form-group">
                                    <label>تلفن همراه*</label>
                                    <input type="text" name="PhoneNumber" value="@TempData["PhoneNumber"].ToString()" class="form-control" required readonly>
                                    <span style="color:red">@Error</span>
                                </div>
                                <div class="form-group">
                                    <label>کد تایید*</label>
                                    <input type="number" name="Otp" class="form-control" max="999999" required>
                                </div>
                                <div class="form-group">
                                    <button style="background-color:#4e8f97" type="submit" class="btn btn_apply w-100">ثبت</button>
                                </div>
                                <div class="form-group text-center mb-0 mt-3">
                                    <a href="/auth/login" class="theme-cl">ورود</a>
                                </div>

                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>