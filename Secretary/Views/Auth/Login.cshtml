@using Secretary.Models;
@model UserDto
@{
    Layout = "_SignUpLayout";
}
<!-- BEGIN LOEADING -->
<div id="loader">
    <div class="spinner"></div>
</div><!-- /loader -->
<!-- END LOEADING -->
<!-- BEGIN WRAPPER -->
<div class="fixed-modal-bg"></div>
<a href="#" class="btn btn-info btn-icon btn-round btn-lg" id="toggle-dark-mode">
    <i class="icon-bulb"></i>
</a>
<div class="modal-page shadow">
    <div class="container-fluid">
        <div class="row">

            <div class="col-md-12">
                <div class="logo-con m-t-10 m-b-10">
                </div><!-- /.logo-con -->

                <h1 class="text-center m-b-20"> کدینیتی</h1>
                <h3 class="text-center m-b-20">ورود ادمین </h3>
                <hr>
                <form asp-action="LogIn" asp-controller="Auth" method="POST" role="form">
                    <div class="form-group">
                        <label class="sr-only">نام کاربری</label>
                        <div class="input-group round">
                            <span class="input-group-addon">
                                <i class="icon-envelope"></i>
                            </span>
                            <input class="form-control ltr text-left" type="text" asp-for="UserName" required>

                        </div><!-- /.input-group -->
                    </div><!-- /.form-group -->
                    <div class="form-group">
                        <label class="sr-only">رمز عبور</label>
                        <div class="input-group round">
                            <span class="input-group-addon">
                                <i class="icon-envelope"></i>
                            </span>
                            <input class="form-control ltr text-left" type="text" asp-for="Password" required>
                            <hr>

                            <span asp-validation-for="Password" style="color:red"></span>

                        </div><!-- /.input-group -->
                    </div><!-- /.form-group -->
                    <p>
                        <button class="btn btn-info btn-round btn-block" type="submit">
                            <i class="icon-paper-plane font-lg"></i>
                            ورود
                        </button>
                    </p>
                </form>
                <hr class="m-b-30">
            </div><!-- /.col-md-12 -->
        </div><!-- /.row -->
    </div><!-- /.container-fluid -->
</div><!-- /.modal-page -->
<!-- END WRAPPER -->
<!-- BEGIN JS -->
<script src="~/assets/plugins/jquery/dist/jquery-3.6.1.min.js"></script>
<script src="~/assets/plugins/jquery-migrate/jquery-migrate-1.2.1.min.js"></script>
<script src="~/assets/plugins/bootstrap/bootstrap5/js/bootstrap.bundle.min.js"></script>
<script src="~/assets/plugins/paper-ripple/dist/PaperRipple.min.js"></script>
<script src="~/assets/plugins/sweetalert2//dist/sweetalert2.min.js"></script>
<script src="~/assets/plugins/iCheck/icheck.min.js"></script>
<script src="~/assets/plugins/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/assets/plugins/jquery-validation/src/localization/messages_fa.js"></script>
<script src="~/assets/js/core.js"></script>

<!-- BEGIN PAGE JAVASCRIPT -->
<script src="~/assets/js/pages/login.js"></script>
<!-- END PAGE JAVASCRIPT -->
