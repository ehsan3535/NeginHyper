@using Secretary.Models;
@model UserDto
<!-- BEGIN PAGE CONTENT -->
<!-- BEGIN BREADCRUMB -->
<div class="col-md-12">
    <div class="breadcrumb-box border shadow">
        <ul class="breadcrumb">
            <li><a href="ShowWorker"> لیست کاربران</a></li>
            <li><a href="ShowWorker">مشخصات کاربر </a></li>
        </ul>
        <div class="breadcrumb-left">
            @DNTPersianUtils.Core.FriendlyPersianDateUtils.ToPersianDateTextify(DateTime.Now)
            <i class="icon-calendar"></i>
        </div><!-- /.breadcrumb-left -->
    </div><!-- /.breadcrumb-box -->
</div><!-- /.col-md-12 -->
<!-- END BREADCRUMB -->
<!-- START ADDWORKER -->
<div class="col-lg-12">
    <div class="portlet box border shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-settings"></i>
                    مشاهده کاربر
                </h3>


            </div><!-- /.portlet-title -->
            <div class="buttons-box">
                <!-- <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                    <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                </a> -->
                <div class="code-modal hide">
                </div>
                <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                    <i class="icon-size-fullscreen"></i>
                </a>
                <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                    <i class="icon-arrow-up"></i>
                </a>
            </div><!-- /.buttons-box -->
        </div><!-- /.portlet-heading -->
        @if (Model.FromArian)
        {
            
        <h2 style="color:midnightblue">
            ساکن آرین 
            </h2>
        }
        <div class="portlet-body">
            <div class="form-group round">
                <label>نام کاربری </label>
                <input asp-for="UserName" type="text" class="form-control" required>
                <span asp-validation-for="UserName" style="color:red"></span>
            </div><!-- /.form-group -->

            <div class="form-group">
                <label>نام </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="fas fa-circle-notch"></i>
                    </span>
                    <input asp-for="Fname" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
            <div class="form-group">
                <label>نام خانوادگی</label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="fas fa-circle-notch"></i>
                    </span>
                    <input asp-for="Lname" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
            <div class="form-group">
                <label>شماره موبایل </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="PhoneNumber" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
            <div class="form-group">
                <label>استان </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="Province" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
            <div class="form-group">
                <label>شهر </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="City" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
            @if (Model.FromArian)
            {
                <h2 style="color:midnightblue">
                    ساکن آرین
                </h2>
            }
            <div class="form-group">
                <label>آدرس </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="AddressLocation" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
             <div class="form-group">
                <label>کد پستی </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="PostalCode1" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
             <div class="form-group">
                <label>پلاک </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="Pelak" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
             <div class="form-group">
                <label>واحد </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="vahed" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->
             <div class="form-group">
                <label>نام گیرنده  </label>
                <div class="input-group">
                    <span class="input-group-addon">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                    </span>
                    <input asp-for="WhoGetIt" type="text" class="form-control" required>
                </div><!-- /.input-group -->
            </div><!-- /.form-group -->

        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
    <!-- END ADDWORKER -->
</div><!-- /.row -->
    </div>
</div>
<!-- /#page-content -->
<!-- END PAGE CONTENT -->
