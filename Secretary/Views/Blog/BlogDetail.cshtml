@using Secretary.Models;
@model BlogDto
<div class="row">

    <div class="col-lg-12">
        <div class="portlet box border shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-magic-wand"></i>
                        مشاهده مقاله
                    </h3>
                </div><!-- /.portlet-title -->
            </div><!-- /.portlet-heading -->
            <div class="portlet-body">
                <div class="row">

                    <div class="col-lg-12">
                        <div class="portlet box border shadow">
                            <div class="portlet-heading">
                                <div class="portlet-title">
                                    <h3 class="title">

                                        ویژگی های مقالهُ
                                    </h3>
                                </div><!-- /.portlet-title -->
                                <div class="buttons-box">
                                    <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                                        <i class="icon-size-fullscreen"></i>
                                    </a>
                                    <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                                        <i class="icon-arrow-up"></i>
                                    </a>
                                </div><!-- /.buttons-box -->
                            </div><!-- /.portlet-heading -->
                            <div class="portlet-body">
                                <div class="form-group">

                                    <div class="input-group">
                                        <p>
                                            <h4>
                                                عنوان   : @Model.Title
                                            </h4>
                                        </p>
                                        <p>
                                            <h4>
                                                نام دسته بندی  : @Model.CategoryName
                                            </h4>
                                        </p>

                                    </div><!-- /.input-group -->
                                    <hr>
                                    @if (Model.Description.HasValue())
                                    {
                                        <textarea id="body" asp-for="Description">@Html.Raw(Model.Description)</textarea>
                                    }
                                </div><!-- /.info-hover -->
                                <img src="@Model.ImageLink" class="img-center img-responsive" alt="">
                            </div><!-- /.effect -->

                        </div><!-- /.portlet-body -->
                    </div><!-- /.portlet -->
                </div><!-- /.col-lg-6 -->
            </div><!-- /.row -->

        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->
@section Scripts{

    <script src="/ckeditor5/build/ckeditor.js"></script>
    <script>
        ClassicEditor
            .create(document.querySelector('#body'),
                {
                    ckfinder: {
                        // Upload the images to the server using the CKFinder QuickUpload command.
                        uploadUrl: '/Blog/SaveImage'
                    },
                    htmlSupport: {
                        allow: [
                            {
                                name: /.*/,
                                attributes: true,
                                classes: true,
                                styles: true
                            }
                        ]
                    }
                })
            .catch(error => { console.error(error); });
    </script>
    <!-- END PAGE JAVASCRIPT -->
        }
