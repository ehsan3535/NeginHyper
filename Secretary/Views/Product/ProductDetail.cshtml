@using Secretary.Models.ProductDto;
@model ProductDto
<div class="col-lg-12">
    <div class="portlet box border shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    <i class="icon-magic-wand"></i>
                    مشاهده محصول
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="row">

                <div class="col-lg-6">
                    <div class="portlet box border shadow">
                        <div class="portlet-heading">
                            <div class="portlet-title">
                                <h3 class="title">

                                    ویژگی های محصول
                                </h3>
                            </div><!-- /.portlet-title -->
                            <div class="buttons-box">
                                <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                                    <i class="icon-size-fullscreen"></i>
                                </a>
                                <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                                    <i class="icon-arrow-up"></i>
                                </a>
                            </div><!-- /.buttons-box -->
                        </div><!-- /.portlet-heading -->
                        <div class="portlet-body">
                            <div class="form-group">

                                <div class="input-group">
                                    <p>
                                        <label>
                                            شماره محصول : @Model.Number
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            نام محصول :@Model.Name
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            وزن خالص :@Model.Pureweight
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                           وزن با بسته بندی :@Model.Allweight
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            مناسب برای :@Model.GoodForWhat
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            دسته بندی :@Model.CategorysName
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            شیوه نگهداری :@Model.KeepWay
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            زمان ماندگاری :@Model.KeepTime   
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            مواد اولیه :@Model.Matterial
                                        </label>
                                    </p> 
                                    <p>
                                        <label>
                                            قیمت :@Model.Price.ToNumeric()
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            قیمت با تخفیف :@Model.Discount.ToNumeric()
                                        </label>
                                    </p>
                                    <p>
                                        <label>
                                            تعداد موجود :@Model.Count
                                        </label>
                                    </p>
                                </div><!-- /.input-group -->
                                <hr>
                                <div class="input-group">
                                    <div class="form-group row">
                                        <label class="col-sm-3"> جزئیات محصول</label>
                                        <div class="col-lg-12">
                                            <textarea class="form-control" rows="5" placeholder="@Model.Detail"></textarea>
                                        </div>
                                    </div><!-- /.input-group -->
                                    <hr>
                                </div><!-- /.form-group -->
                              

                                <h3>عکس کاور محصول</h3>
                                <div class="col-md-12 col-sm-12">
                                    <div class="effect bottom-to-top-effect">
                                        <div class="info-hover">
                                            <a href="/Product/EditProduct?id=@Model.Id" class="url">
                                            </a>
                                        </div><!-- /.info-hover -->
                                        <img src="@Model.ImageCoverUrl" style="width: 400px; height: 400px;" class="img-center img-responsive" alt="">
                                    </div><!-- /.effect -->
                                </div><!-- /.col -->

                            </div><!-- /.portlet-body -->
                        </div><!-- /.portlet -->
                    </div><!-- /.col-lg-6 -->
                </div><!-- /.row -->

                <div class="col-6">
                    <h3>عکس های محصول</h3>


                    @if (Model.ProductImages!= null && Model.ProductImages.Any())
                    {
                        @foreach (var i in Model.ProductImages)
                        {

                            <div class="col-md-12 col-sm-12">
                                <div class="effect bottom-to-top-effect">
                                    <div class="info-hover">
                                        <a href="/Product/EditProduct?id=@Model.Id" class="url">
                                        </a>
                                    </div><!-- /.info-hover -->
                                    <img src="@i.ImageLink"  class="img-center img-responsive" alt="">
                                </div><!-- /.effect -->
                            </div>

                            <!-- /.col -->
                        }
                    }


                </div>

            </div><!-- /.portlet-body -->
        </div><!-- /.portlet -->
    </div><!-- /.col-lg-12 -->
