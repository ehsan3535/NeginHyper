@using Secretary.Models;
@model List<FreeTimeDto>

@section Style{
    <link href="~/assets_Admin/plugins/noty/css/flat.css" rel="stylesheet">
}
<div class="row">

    <div class="col-lg-12">
        <div class="portlet box border shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                        تنظیمات زمان ارسال
                    </h3>
                </div><!-- /.portlet-title -->
                <div class="buttons-box">
                    <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                        <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                    </a>
                    <div class="code-modal hide">
                    </div>
                    <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                        <i class="icon-size-fullscreen"></i>
                    </a>
                    <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                        <i class="icon-arrow-up"></i>
                    </a>
                </div><!-- /.buttons-box -->
            </div><!-- /.portlet-heading -->
            <div class="portlet-body">
                <div class="row">
                    <div class="col-md-4 col-12 m-b-20">

                        <a class="btn btn-success btn-round" href="#">
                            <i></i>
                            @Model.First().DateTime.ToPersianDateTextify()
                        </a>


                    </div><!-- /.col-md-4 -->
                </div><!-- /.row -->

                <form method="get" asp-action="FreeTimes" asp-controller="Setting">
                    <h6 class="mb-0">روز هفته را انتخاب کنید:</h6>

                    <select onchange="submitForm()" name="Date" class="form-control select2 curve">
                        <option selected>  انتخاب کنید</option>
                        @foreach (var item in Model.First().AllTimes.OrderBy(x => x.DateTime))
                        {
                            <option value="@item.DateTime.Date">@item.DateTime.ToPersianDateTextify()</option>
                        }
                    </select>

                    <button id="gg" type="submit" hidden></button>
                </form>
                <br />
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th>ردیف</th>
                                <th>ساعت</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var j = 0;
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td>لیست شما خالی میباشد.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var item in Model)
                                {
                                    j++;
                                    <tr>
                                        <td>@j</td>
                                        <td>@item.FromHour - @item.ToHour</td>
                                        @if (item.Free)
                                        {
                                            <td>آزاد</td>
                                            <td>
                                                <a href="/Setting/ChangeFreeStatus?id=@item.Id&&Free=false" class="btn btn-danger btn-round">
                                                    <i class="icon-trash"></i>
                                                    تغییر به مشغول
                                                </a>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>مشغول</td>
                                            <td>
                                                <a href="/Setting/ChangeFreeStatus?id=@item.Id&&Free=true" class="btn btn-info btn-round">
                                                    <i class="icon-note"></i>
                                                    تغییر به آزاد
                                                </a>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div><!-- /.table-responsive -->
                <div class="text-center">
                    <ul class="pagination round">
                        <li>
                            <a href="#">
                                <i class="icon-control-end"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-arrow-right"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">1</a>
                        </li>
                        <li>
                            <span class="active" href="#">2</span>
                        </li>
                        <li>
                            <a href="#">3</a>
                        </li>
                        <li>
                            <a href="#">4</a>
                        </li>
                        <li>
                            <a href="#">5</a>
                        </li>
                        <li>
                            <a href="#">6</a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-arrow-left"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-control-start"></i>
                            </a>
                        </li>
                    </ul>
                </div><!-- /.text-center -->
            </div><!-- /.portlet-body -->
        </div><!-- /.portlet -->
    </div><!-- /.col-lg-12 -->


</div><!-- /.row -->
@section Scripts{
    <script src="~/assets_Admin/plugins/noty/js/noty/packaged/jquery.noty.packaged.min.js"></script>
    <script src="~/assets_Admin/js/pages/noty.js"></script>
    <script>
        function submitForm() {
            //document.getElementsByName("Shop").submit();
            document.getElementById("gg").click();
        }
    </script>
   }
