@using Secretary.Models;
@model ContactDto

<!-- BEGIN PAGE CONTENT -->

        <!-- BEGIN BREADCRUMB -->
        <div class="col-md-12">
            <div class="breadcrumb-box border shadow">
                <ul class="breadcrumb">
                    <li><a href="ShowWorker">ارتباط با ما </a></li>
                    <li><a href="ShowWorker">مشاهده جزئیات </a></li>
                </ul>
                <div class="breadcrumb-left">
                                                @DNTPersianUtils.Core.FriendlyPersianDateUtils.ToPersianDateTextify(DateTime.Now)
                    <i class="icon-calendar"></i>
                </div><!-- /.breadcrumb-left -->
            </div><!-- /.breadcrumb-box -->
        </div><!-- /.col-md-12 -->
        <!-- END BREADCRUMB -->
        <!-- START ADDWORKER -->
        <div class="col-lg-12">
            <div class="portlet box border shadow">
                <div class="portlet-heading">
                    <div class="portlet-title">

                       
                            <h3 class="title">
                                <i class="icon-shield"></i>
                                 نمایش فرم ارتباط با ما 
                            </h3>
                        
                    </div><!-- /.portlet-title -->
                    <div class="buttons-box">
                        <!-- <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                            <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                        </a> -->
                        <div class="code-modal hide">
                        </div>
                        <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                            <i class="icon-size-fullscreen"></i>
                        </a>
                        <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                            <i class="icon-arrow-up"></i>
                        </a>
                    </div><!-- /.buttons-box -->
                </div><!-- /.portlet-heading -->
                <div class="portlet-body">

                        
                        <div class="form-group">
                            <label> موضوع :</label>
                            <div class="input-group">
                                <span class="input-group-addon">
                                    <i class="icon-user"></i>
                                </span>
                                <input type="text" asp-for="Title" class="form-control" placeholder="نام و نام خانوادگی">
                            </div><!-- /.input-group -->
                        </div><!-- /.form-group -->
                        <div class="form-group">
                            <label> تلفن همراه: </label>
                            <div class="input-group">
                                <span class="input-group-addon">
                                    <i class="icon-user"></i>
                                </span>
                                <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="تلفن همراه">
                            </div><!-- /.input-group -->
                        </div><!-- /.form-group -->
                        <div class="form-group">
                            <label>توضیحات: </label>
                            <div class="input-group">
                                <span class="input-group-addon">
                                    <i class="icon-key"></i>
                                </span>
                            <input type="text" asp-for="Description" class="form-control" placeholder=" توضیحات">
                            </div><!-- /.input-group -->
                        </div><!-- /.form-group -->
                </div><!-- /.portlet-body -->
            </div><!-- /.portlet -->
            <!-- END ADDWORKER -->
        </div><!-- /.row -->
    </div>
</div>
<!-- /#page-content -->
<!-- END PAGE CONTENT -->

