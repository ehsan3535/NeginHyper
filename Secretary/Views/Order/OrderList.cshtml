@using Secretary.Models.Orders;
@model List<OrderDto>

@section Style
    {
    <link href="~/assets_Admin/plugins/noty/css/flat.css" rel="stylesheet">
}

<div class="row">

    <div class="col-lg-12">
        <div class="portlet box border shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                        فهرست سفارشات
                    </h3>
                </div><!-- /.portlet-title -->
                <div class="buttons-box">
                    <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                        <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                    </a>
                    <div class="code-modal hide">
                    </div>
                    <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                        <i class="icon-size-fullscreen"></i>
                    </a>
                    <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                        <i class="icon-arrow-up"></i>
                    </a>
                </div><!-- /.buttons-box -->
            </div><!-- /.portlet-heading -->
            <div class="portlet-body">
                <div class="row">
                   @* <div class="col-md-4 col-12 m-b-20">
                        <a class="btn btn-success btn-round" href="javascript:window.print()">
                            <i class="icon-plus"></i>
                           پرینت
                        </a>
                    </div><!-- /.col-md-4 -->*@
                </div><!-- /.row -->
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th><i class="icon-energy"></i></th>
                                <th>نام خریدار</th>
                                <th>مبلغ کل سبد</th>
                                <th> وضعیت</th>
                                <th> زمان ارسال</th>
                                <th>شماره فاکتور</th>
                                <th>تخفیف</th>
                                <th>تغییر وضعیت به</th>
                                <th>مدیریت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var i = 0;
                            }
                            @foreach (var item in Model)
                            {
                                if (item.TotalPrice != 0)
                                {
                                    i++;
                                    <tr>
                                        <td>@i</td>
                                        <td>
                                            <span>
                                                @item.UserUserName
                                            </span>
                                        </td>
                                        <td>@item.TotalPrice</td>
                                        @if (item.PaymentStatus == PaymentStatus.Waiting)
                                        {
                                            <td>
                                                <label class="btn btn-info btn-round btn-noty-with-buttons">در انتظار پرداخت</label>
                                            </td>
                                        }
                                        @if (item.PaymentStatus == PaymentStatus.Payed)
                                        {
                                            <td>
                                                <label class="btn btn-info btn-round btn-noty-with-buttons">پرداخت شده</label>
                                            </td>
                                        }
                                        @if (item.PaymentStatus == PaymentStatus.Sending)
                                        {
                                            <td>
                                                <label class="label-danger round">در حال ارسال</label>
                                            </td>
                                        }
                                        @if (item.PaymentStatus == PaymentStatus.Sent)
                                        {
                                            <td>
                                                <label class="label-warning round">ارسال شده</label>
                                            </td>
                                        }
                                        @if (item.PaymentStatus == PaymentStatus.Gived)
                                        {
                                            <td>
                                                <label class="label-success round">دریافت شده</label>
                                            </td>
                                        }
                                        <td>
                                            @if (item.FreeTimeDay == "1")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour تا @item.FreeTimeToHour - شنبه
                                                </span>
                                            }
                                            @if (item.FreeTimeDay == "2")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour تا @item.FreeTimeToHour - یک شنبه
                                                </span>
                                            }
                                            @if (item.FreeTimeDay == "3")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour  تا @item.FreeTimeToHour - دو شنبه
                                                </span>
                                            }
                                            @if (item.FreeTimeDay == "4")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour تا @item.FreeTimeToHour - سه شنبه
                                                </span>
                                            }
                                            @if (item.FreeTimeDay == "5")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour تا @item.FreeTimeToHour - چهارشنبه
                                                </span>
                                            }
                                            @if (item.FreeTimeDay == "6")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour تا  @item.FreeTimeToHour - پنج شنبه
                                                </span>
                                            }
                                            @if (item.FreeTimeDay == "7")
                                            {
                                                <span>
                                                    ساعت @item.FreeTimeFromHour تا @item.FreeTimeToHour - جمعه
                                                </span>
                                            }

                                        </td>
                                        <td>@item.FactorNumber</td>
                                        <td>@item.DiscountPercent %</td>
                                        <form Type="Post" asp-action="ChangeStatus" asp-controller="Order">
                                        <td>
                                            <input name="Id" value="@item.Id" hidden />
                                            <input name="TotalPrice" value="@item.TotalPrice" hidden />
                                            <input name="UserId" value="@item.UserId" hidden />
                                            <select onselect="function1()" name="PaymentStatus" value="@item.PaymentStatus" class="form-select round">
                                                <option value="0">در انتظار پرداخت</option>
                                                <option value="1">پرداخت شده </option>
                                                <option value="2">درحال ارسال</option>
                                                <option value="3">ارسال شده</option>
                                                <option value="4">دریافت شده</option>
                                            </select>
                                        </td>
                                        <td>
                                            <button type="submit" id="g" style="background-color:#4e8f97;" class="btn btn-danger btn-round btn-noty-with-buttons" >ثبت </button>
                                        </td>
                                        </form>
                                        <td>
                                            <!-- مودال مشاهده یه تگ دیو داره که بعد از بادی قرارش دادم -->
                                            <a href="/Order/Invoice?OrderId=@item.Id" target="_blank" class="btn btn-success btn-round">
                                                <i class="icon-eyeglass"></i>
                                                فاکتور
                                            </a>
                                            <br>
                                            <a href="/Order/OrderDetail?UserId=@item.UserId" class="btn btn-success btn-round">
                                                <i class="icon-eyeglass"></i>
                                                سفارشات
                                            </a>
                                            <br>
                                            <a href="/auth/UserDetail?id=@item.UserId" class="btn btn-info btn-round">
                                                <i class="icon-note"></i>
                                                آدرس و مشخصات مشتری
                                            </a>
                                            <br>
                                            <a href="/Order/DeleteOrder?Id=@item.Id" class="btn btn-danger btn-round btn-noty-with-buttons">
                                                <i class="icon-trash"></i>
                                                حذف
                                            </a>
                                        </td>

                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div><!-- /.table-responsive -->
                <div class="text-center">
                    <ul class="pagination round">
                        <li>
                            <a href="#">
                                <i class="icon-control-end"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-arrow-right"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">1</a>
                        </li>
                        <li>
                            <span class="active" href="#">2</span>
                        </li>
                        <li>
                            <a href="#">3</a>
                        </li>
                        <li>
                            <a href="#">4</a>
                        </li>
                        <li>
                            <a href="#">5</a>
                        </li>
                        <li>
                            <a href="#">6</a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-arrow-left"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-control-start"></i>
                            </a>
                        </li>
                    </ul>
                </div><!-- /.text-center -->
            </div><!-- /.portlet-body -->
        </div><!-- /.portlet -->
    </div><!-- /.col-lg-12 -->


</div><!-- /.row -->
@section Scripts{


    <script src="~/assets_Admin/plugins/noty/js/noty/packaged/jquery.noty.packaged.min.js"></script>
    <script src="~/assets_Admin/js/pages/noty.js"></script>
                }