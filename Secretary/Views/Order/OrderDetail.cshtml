@using Secretary.Models.Orders;
@model OrderDto

@section Style{
    <link href="~/assets_Admin/plugins/noty/css/flat.css" rel="stylesheet">
}
<div class="row">

    <div class="col-lg-12">
        <div class="portlet box border shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-basket-loaded fa-flip-horizontal"></i>
                        فهرست سفارشات
                    </h3>
                </div><!-- /.portlet-title -->
                <div class="buttons-box">
                    <a class="btn btn-sm btn-default btn-round btn-code" rel="tooltip" title="کدها" href="#">
                        <i class="icon-arrow-left"></i><span>/</span><i class="icon-arrow-right"></i>
                    </a>
                    <div class="code-modal hide">
                    </div>
                    <a class="btn btn-sm btn-default btn-round btn-fullscreen" rel="tooltip" title="تمام صفحه" href="#">
                        <i class="icon-size-fullscreen"></i>
                    </a>
                    <a class="btn btn-sm btn-default btn-round btn-collapse" rel="tooltip" title="کوچک کردن" href="#">
                        <i class="icon-arrow-up"></i>
                    </a>
                </div><!-- /.buttons-box -->
            </div><!-- /.portlet-heading -->
            <div class="portlet-body">
                <div class="row">

                    <div class="col-md-4 col-12 m-b-20">
                        <form role="form">
                            <div class="input-group round">
                                <input type="text" class="form-control" placeholder="جستجو...">
                                <span class="input-group-btn">
                                    <button class="btn btn-default" type="button">
                                        <i class="icon-magnifier"></i>
                                        <div class="paper-ripple">
                                    </button>
                                </span>
                            </div><!-- ./input-group -->
                        </form>
                    </div><!-- /.col-md-4 -->
                    <
                </div><!-- /.row -->
                <div class="table-responsive">
                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th><i class="icon-energy"></i></th>
                                <th>نام محصول</th>
                                <th>تاریخ</th>
                                <th>تعداد</th>
                                <th>مبلغ</th>
                                <th>مدیریت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var i = 0;
                            }
                            @if (Model.OrderDetails.Any())
                            {

                                @foreach (var item in Model.OrderDetails)
                                {
                                    i++;
                                    <tr>
                                        <td>@i</td>
                                        <td>
                                            <img class="img-person img-circle" src="@item.ProductsImageLink">
                                            <span>
                                                @item.ProductsName
                                            </span>
                                        </td>
                                        <td>@item.CreationDateTime.FormatDateToLongPersianDateTime()</td>
                                        <td>@item.Count</td>
                                        <td>@item.Price</td>
                                        <td>
                                            <a href="/Product/ProductDetail?id=@item.ProductsId" class="btn btn-success btn-round">
                                                <i class="icon-eyeglass"></i>
                                                مشاهده محصول
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>هنوز سفارشی ثبت نشده است</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div><!-- /.table-responsive -->
                <div class="text-center">
                    <ul class="pagination round">
                        <li>
                            <a href="#">
                                <i class="icon-control-end"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-arrow-right"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">1</a>
                        </li>
                        <li>
                            <span class="active" href="#">2</span>
                        </li>
                        <li>
                            <a href="#">3</a>
                        </li>
                        <li>
                            <a href="#">4</a>
                        </li>
                        <li>
                            <a href="#">5</a>
                        </li>
                        <li>
                            <a href="#">6</a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-arrow-left"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="icon-control-start"></i>
                            </a>
                        </li>
                    </ul>
                </div><!-- /.text-center -->
            </div><!-- /.portlet-body -->
        </div><!-- /.portlet -->
    </div><!-- /.col-lg-12 -->


</div><!-- /.row -->
@section Scripts{
    <script src="~/assets_Admin/plugins/noty/js/noty/packaged/jquery.noty.packaged.min.js"></script>
    <script src="~/assets_Admin/js/pages/noty.js"></script>
                }