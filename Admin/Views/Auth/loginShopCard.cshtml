@using Client.Models.Dtos;
@model LoginOtpDto




<div class="row justify-content-center w-100">
    <div class="col-12">
        <div class="site-login">
            <h1 class="centered-header">ورود به سایت</h1>
            <p class="text-center">لطفا برای ورود به سایت شماره تماس خود را وارد کنید </p>
            <div class="clearfix">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-sm-8 col-lg-push-3 col-sm-push-2 m-t-30">
                        <div class="row">
                           <form id="login-form" asp-action="LogInOtpshopcard" asp-controller="Auth" method="get" role="form">

          

                <div class="form-group ltr field-loginform-mobile required">
                                    <label class="control-label w-50" for="loginform-mobile">شماره موبایل</label>
                                    <input type="text"
                                    autocomplete="off"
                                    style="border:1px solid grey"
                                           id="loginform-mobile"
                                           class="form-control py-4 mt-5"
                                           placeholder="- - - - - -"
                                            asp-for="PhoneNumber"
                                           autofocus
                                           required
                                           aria-required="true" />

                                           <input type="text"
                                           autocomplete="off"
                                            asp-for="ClientId"
                                            value="@TempData["ClientId"].ToString()"
                                           hidden
                                            />

                                </div>

                <button type="submit" class="mt-5 default__button button--medium">ارسال کد </button>
                <br />
                <button class="text-black vazir" style="text-align:center; width:100%" data-bs-toggle="modal" data-bs-target="#modal-group"> می خواهم با رمز عبور وارد شوم </button>
                <br />

        </form>
							<br />
							<br />
                          
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

