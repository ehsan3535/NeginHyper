<!-- Modal -->
<div class="modal" id="modal-group" tabindex="-1" aria-labelledby="modal-groupLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-scrollable modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">



            <div class="modal-body w-100 justify-content-center" style="height:350px">
                <div class="row justify-content-between w-100 h-100">
                    <div class="col-12 col-lg-6 col-md-6 col-sm-12 justify-content-center my-auto">
                        <div class="d-flex flex-column my-auto">

                        <a href="/auth/login" class="mx-auto">
                            <img src="/assets/images/login.png" />
                        </a>
                        <a href="/auth/login" class="mx-auto">
                            <span>ورود</span>
                        </a>
                        </div>
                    </div>
                    <div class="col-12 col-lg-6 col-md-6 col-sm-12 justify-content-center my-auto">
                        <div class="d-flex flex-column my-auto">
                        <a href="/auth/signup" class="mx-auto">
                            <img src="/assets/images/signup.png" />
                        </a>
                        <a href="/auth/signup" class="mx-auto">
                            <span>عضویت</span>

                        </a>
                        </div>
                    </div>
                </div>

            </div>



        </div>
    </div>
</div>
