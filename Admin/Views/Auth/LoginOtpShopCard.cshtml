@using Client.Models.Dtos;
@model LoginOtpDto



<div class="row justify-content-center w-100">
    <div class="col-12">
        <div class="site-login mx-auto">
            <h2 class="centered-header"> تایید شماره </h2>
            <div class="row justify-content-between">
                <span style="text-align:center; width:100%">کد ارسال شده به شماره @TempData["UserName1"].ToString() را وارد نمایید</span>
            </div>
            <div class="clearfix">
                <div class="row justify-content-center">
                    <div class="col-lg-6 col-sm-8 col-lg-push-3 col-sm-push-2 m-t-30">
                        <div class="row">
                            <form asp-action="LogInOtpShopCard" asp-controller="Auth" method="POST" role="form">


                                <input asp-for="PhoneNumber" autocomplete="off" value="@TempData["UserName1"].ToString()" hidden />
                                @if (TempData["OTP"] != null)
                                {
                                    <input type="texy" asp-for="OTP" autocomplete="off" value="@TempData["OTP"].ToString()" hidden />
                                }
                                <div class="form-group ltr field-loginform-mobile required">
                                    <input type="text"
                                           style="border:1px solid grey"
                                           id="loginform-mobile"
                                           class="form-control py-4 mt-5"
                                           placeholder="- - - - - -"
                                           asp-for="Code"
                                           autocomplete="off"
                                           required
                                           autofocus
                                           aria-required="true" />

                                    <input type="text"
                                           asp-for="ClientId"
                                           autocomplete="off"
                                           value="@TempData["ClientId"].ToString()"
                                           hidden />
                                </div>
                                <div style="text-align:center; width:100%" class="app">
                                    <a href="/auth/LogInOtpSHopCard?PhoneNumber=@TempData["UserName1"].ToString()&ClientId=@TempData["ClientId"].ToString()&resend=true" id="Sendagain" hidden style="color:cadetblue">ارسال مجدد کد</a>
                                    <time style="text-align:center; width:100%" id="countdown">2:00</time>
                                </div>
                                <button type="submit" class="mt-5 default__button button--medium">ثبت کد </button>
                                <div class="row justify-content-center">
                                    <a style="text-align:center; width:100%; margin-right:auto; margin-left:auto;" href="/auth/loginShopcard?ClientId=@TempData["ClientId"].ToString()">تغییر شماره تماس</a>

                                </div>
                                <br />
                                <button class="text-black vazir" style="text-align:center; width:100%" data-bs-toggle="modal" data-bs-target="#modal-group"> می خواهم با رمز عبور وارد شوم </button>

                            </form>
                            <br />
                            <br />

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

