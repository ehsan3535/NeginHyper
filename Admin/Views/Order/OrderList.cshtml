@using Client.Models.Orders;
@model List<OrderDto>
<div class="container my-3">
    <div class="row my-4">
        <ul class="nav nav-pills nav-fill">
            <li class="nav-item">
                <a class="nav-link active" href="#">سفارشات پیشین</a>
            </li>
            <li class="nav-item">
                <a class="nav-link " href="/Notification/NotificationList">اعلانات </a>
            </li>
            <li class="nav-item">
                <a class="nav-link " aria-current="page" href="/home/addressprofile">آدرس ها</a>
            </li>

        </ul>
    </div>
    <div class="row">
        <div class="col-12 col-lg-9 col-md-12 col-sm-12">
            <section class="card br-20 px-5" style="max-height: 100px">
                <div class="card-body">
                    <h2 class="text-success">سفارشات من</h2>
                </div>
            </section>

            <div class="card mx-3 br-20">
                <div class="card-body">
                    <div class="row w-100">
                        <div class="col-6 col-lg-3 col-md-3 col-sm-6">
                            <h6 class="card-title bg-info-gradient br-20 text-center">
                                سفارشات پیشین
                            </h6>
                        </div>
                    </div>

                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <div class="form-check my-2">
                                <div class="card shadow my-2">
                                    <h5 class="card-header">@item.CreationDateTime.ToLongPersianDateString()</h5>
                                    <div class="card-body">
                                        <h5 class="card-title">قیمت پرداختی : @item.TotalPrice.ToNumeric() </h5>
                                        <p class="card-text"> وضعیت : @item.PaymentStatus.ToDisplay() </p>
                                        <a href="/Order/Invoice?OrderId=@item.Id" class="btn bg-success">مشاهده فاکتور </a>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <h5 class="card-title">هنوز سفارشی ثبت نشده است. </h5>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-3 col-md-12 col-sm-12">
            <div class="card br-20">
                <div class="card-body">
                    <div class="row justify-content-center">
                        <h2 style="text-align: center">@TempData["Name"]</h2>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-6">
                            <span class="card-title"
                                  style="font-weight: bold; font-size: large">شماره تلفن</span>
                        </div>
                        <div class="col-6">
                            <span class="text-success"
                                  style="font-weight: bold; font-size: medium">
                                @TempData["Phone"]
                            </span>
                        </div>
                    </div>
                    <br />

                </div>
            </div>
        </div>
    </div>
</div>
