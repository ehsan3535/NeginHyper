@using Client.Models.ProductDto;
@model List<ProductDto>

@if (Model.Any())
{


    @foreach (var item in Model)
    {
            <li class="mobilemenu__li">
            <a href="/Product/ProductDetail_User?id=@item.Id">@item.Name</a>
            </li>
    }
}
else
{
    <li class="mobilemenu__li">
        <p>محصولی از این دسته بندی موجود نیست</p>
    </li>
}