        $(document).ready(function () {
            const clientId = document.cookie
                .split("; ")
                .find((row) => row.startsWith("guid"))
                ?.split("=")[1];
            console.log("hey");
            $.ajax({
                type: "GET",
                url: "/ShopCard/ShopCardCount",
                data: {
                    ClientId: clientId,
                },
                success: function (result) {
                    $("#shopcardcount").html(result);
                },
                error: function (e) {
                    alert("error => " + e.responseText);
                }
            });
        })
    </script>

