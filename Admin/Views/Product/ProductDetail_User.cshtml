                                                    <option selected hidden>@item.Count عدد</option>
                                                    <option value="1">1 عدد</option>
                                                    <option value="2">2 عدد</option>
                                                    <option value="3">3 عدد</option>
                                                    <option value="4">4 عدد</option>
                                                    <option value="5">5 عدد</option>
                                                    <option value="6">6 عدد</option>
                                                    <option value="7">7 عدد</option>
                                                    <option value="8">8 عدد</option>
                                                    <option value="9"> 9 عدد</option>
                                                </select>
                                            </div>
                                            <br>
                                            <div class="row justify-content-start">
                                                <button type="button" style="margin-right:auto; text-align:left;" onclick="DeleteShopCarditem('@item.ProductsId')"><span style="margin-right:auto;text-align:left;" class="text-hover-danger"> حذف</span></button>

                                            </div>

                                            @*                                        <a href="/ShopCard/DeleteShopCardDetail?ShopCardDetailId=@item.Id&&ProductId=@item.ProductsId&&modal=true"><span class="text-danger"> حذف</span></a>
                                *@

                                        </div>
                                    </div>
                                    <hr>
                                    <hr>
                                }

                            }
                            else
                            {
                                <div class="row">
                                    <div class="col-12">
                                        <span style="font-weight: bold; font-size: 18px;">سبد خرید شما خالی میباشد</span>
                                        <br>
                                    </div>
                                </div>
                                <hr>
                            }
                            <div class="row justify-content-start">
                                @*<span class="text-black" style="font-size: 18px; text-align: end; font-weight: bold;">مجموع کل  @Model.ShopCard.TotalPrice.ToNumeric() تومان</span>*@
                                <span class="text-black" style="font-size: 13px; text-align: end; font-weight: 100;">هزینه قابل پرداخت <span class="mx-4">@Model.ShopCard.FinalTotalPrice.ToNumeric() تومان </span> </span>

                            </div>
                            <div class="row">

                                <div class="col-12 col-lg-6 col-md-6 col-sm-12">
                                    @if (Model.ShopCard.TotalPrice >= 500000)
                                    {
                                        <span class="text-black" style="font-size: 15px;">هزینه ارسال برای شما رایگان شد</span>
                                    }
                                    else
                                    {
                                        int UntilFreePost = 500000 - Model.ShopCard.TotalPrice;
                                        <span class="text-black" style="font-size: 15px;">هزینه ارسال @Model.ShopCard.PostPrice.ToNumeric() تومان</span>
                                        <span class=" mx-3"> @UntilFreePost.ToNumeric() تومان تا ارسال رایگان</span>
                                    }
                                    <br>
                                    <div class="progress m-b-20">
                                        <div class="progress-bar" role="progressbar" aria-valuenow="10%" aria-valuemin="0" aria-valuemax="100"></div>
                                    </div>
                                    <span class="" style="font-size: 20px; font-weight: bold;">کد تخفیف در مرحله آخر دریافت میشود</span>
                                </div>

                            </div>
                        </div>
                    </div>
                }

                <div class="modal-footer">
                    <div class="row w-100">

                        <div class="col-6">
                            <a href="/product/shop" type="button" class="default__button button--medium button--outlined" style="border-radius: 50px;text-align:center;">فروشگاه </a>
                        </div>

                        @if (Model.ShopCard.TotalPrice != 0)
                        {
                            <div class="col-6">
                                <button type="button" class="default__button button--medium add-to-cart" style="border-radius: 50px; text-align:center;" onclick="openBasketInModal()">ثبت سفارش</button>
                            </div>
                           @* @if (User.Identity.IsAuthenticated)
                            {
                                <div class="col-6">
                                    <button type="button" class="default__button button--medium add-to-cart" style="border-radius: 50px; text-align:center;" onclick="openBasketInModal()">ثبت سفارش</button>
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    <button type="button" class="default__button button--medium add-to-cart" style="border-radius: 50px; text-align:center;" onclick="openBasketInModal2()">ثبت سفارش</button>
                                </div>
                            }*@
                        }

                    </div>
                </div>
            </div>
        </div>
    </div>

</main>


