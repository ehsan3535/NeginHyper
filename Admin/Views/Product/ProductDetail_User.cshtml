                                {
                                    <p>
                                        <label>
                                            زمان ماندگاری :@Model.KeepTime
                                        </label>
                                    </p>
                                }
                                @if (Model.Matterial != null)
                                {
                                    <p>
                                        <label>
                                            مواد اولیه :@Model.Matterial
                                        </label>
                                    </p>
                                }
                                @if (Model.Pureweight != null)
                                {
                                    <p>
                                        <label>
                                            وزن خالص :@Model.Pureweight
                                        </label>
                                    </p>
                                }
                                @if (Model.Allweight != null)
                                {
                                    <p>
                                        <label>
                                            وزن با بسته بندی :@Model.Allweight
                                        </label>
                                    </p>
                                }
                                @if (Model.GoodForWhat != null)
                                {
                                    <p>
                                        <label>
                                            مناسب برای :@Model.GoodForWhat
                                        </label>
                                    </p>
                                }
                            </div>
                            <div class="col-sm-12 col-lg-6 col-md-6 col-sm-12">
                                <div class="row w-100">
                                    <div class="col-6 col-lg-4 col-md-4 col-sm-6">
                                        <h6 class="card-title bg-danger-gradient br-20 text-center">
                                            درباره محصول
                                        </h6>
                                    </div>
                                </div>
                                <p>@Model.Detail</p>

                            </div>
                        </div>




                        <br>

                    </div>
                </div>
            </div>
        </div>
        <br />



        <div class="card">
            <div class="card-body">
                <h4>تجربه های خریداران</h4>
                <hr />

                <div class="row my-3">
                    @if (Model.Comments.Any())
                    {
                        @foreach (var item in Model.Comments)
                        {
                            @if (item.CommentStatus == CommentStatus.Accepted)
                            {
                                <div class="col">
                                    <div class="row w-100">
                                        <!-- <span>نظری ثبت نشده است</span> -->
                                        <!-- Contenedor Principal -->
                                        <div class="comments-container">
                                            <ul id="comments-list" class="comments-list">
                                                <li>
                                                    <div class="comment-main-level">
                                                        <!-- Avatar -->
                                                        <!-- Contenedor del Comentario -->
                                                        <div class="comment-box">
                                                            <div class="comment-head">
                                                                <div class="comment-avatar m-2"><img src="http://i9.photobucket.com/albums/a88/creaticode/avatar_1_zps8e1c80cd.jpg" alt=""></div>
                                                                <h4 class="comment-name m-2"><a href="http://creaticode.com/blog">@item.Name </a></h4>
                                                                @for (int i = 0; i < Model.Rate; i++)
                                                                {
                                                                    <i class="fa fa-heart m-2"></i>
                                                                }
                                                            </div>
                                                            <div class="comment-content">
                                                                @item.CreationDateTime.ToLongPersianDateString()
                                                            </div>
                                                            <div class="comment-content">
                                                                @item.Text
                                                            </div>
                                                        </div>
                                                    </div>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <p> هنوز کامنتی ثبت نشده است</p>
                    }

                    <div class="col">

                        <div class="row my-3 justify-content-center">
                            <form class="ms-lg-4" method="post" asp-action="AddComment" asp-controller="Comment">
                                <input id="name" name="ProductId" value="@Model.Id" type="text" class="form-control ps-5" hidden>

                                <div class="rate">

                                    <div class="wrapper-rate" style="width: fit-content;">
                                        <span class="m-2" style="top:10px; position: relative;">امتیاز شما</span>

                                        <input name="Rate" type="radio" id="st1" value="5" />
                                        <label for="st1"></label>
                                        <input name="Rate" type="radio" id="st2" value="4" />
                                        <label for="st2"></label>
                                        <input name="Rate" type="radio" id="st3" value="3" />
                                        <label for="st3"></label>
                                        <input name="Rate" type="radio" id="st4" value="2" />
                                        <label for="st4"></label>
                                        <input name="Rate" type="radio" id="st5" value="1" />
                                        <label for="st5"></label>
                                    </div>
                                </div>
                                <input class="searchbox__input fuse__input my-2 w-50 mx-auto"
                                       type="text"
                                       placeholder="نام" />
                                <input class="searchbox__input fuse__input w-50 mx-auto"
                                       type="text"
                                       name="email"
                                       placeholder="ایمیل شما" />

                                <textarea placeholder="نظر خود را بنویسید" name="Text" class="my-3 w-50 mx-auto searchbox__input fuse__input"></textarea>
                                <button type="submit" class="default__button button--medium add-to-cart">ثبت نظر</button>
                            </form><!--end form-->
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>


    <!-- Modal -->
    <div class="modal" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>

                    <h1 class="modal-title fs-5" id="exampleModalLabel">
                        سبد خرید شما تاکنون
                    </h1>
                </div>
                @if (Model.ShopCard != null)
                {
                    <div class="modal-body">
                        <div class="column">
                            <hr>

                            @if (Model.ShopCard.ShopCardDetails != null && Model.ShopCard.ShopCardDetails.Any())
                            {

                                @foreach (var item in Model.ShopCard.ShopCardDetails)
                                {

                                    <div class="row">
                                        <div class="col-12 col-lg-3 col-md-3 col-sm-12">
                                            <img src="@item.ProductsImageLink" alt="" width="100px">
                                        </div>
                                        <div class="col-6">
                                            <span style="font-weight: bold; font-size: 18px;">@item.ProductsName</span>
                                            <br>
                                        </div>
                                        <div class="col-6 col-lg-3 col-md-3 col-sm-6">
                                            <span class="text-black" style="font-size:11px"> @item.ProductsDiscount.ToNumeric() تومان</span>

                                            @*<span class="text-grey mx-2 p-2" style="border: 1px solid grey; border-radius: 20px;"> @item.Count عدد</span>*@
                                            <div class="btn-group">
                                                @*<button class="btn  btn-sm dropdown-toggle" style="border: 1px solid grey; border-radius: 20px;" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @item.Count عدد
                                    </button>*@
