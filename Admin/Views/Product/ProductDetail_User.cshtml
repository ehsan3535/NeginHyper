    <script>
        function DeleteShopCarditem(p) {
            const clientId = document.cookie
                .split("; ")
                .find((row) => row.startsWith("guid"))
                ?.split("=")[1];

            window.open(`/ShopCard/DeleteShopCardDetail?ProductId=${p}&ClientId=${clientId}`, "_self");

        }
    </script>

    <script>
        function openBasketInModal() {
            var authenticated = '@User.Identity.IsAuthenticated';
            const clientId = document.cookie
                .split("; ")
                .find((row) => row.startsWith("guid"))
                ?.split("=")[1];

            if (authenticated) {
                window.open(`/ShopCard/ShopCard_Detail2?ClientId=${clientId}`, "_self");
            }
            else {
                window.open(`/auth/loginShopcard?ClientId=${clientId}`, "_self");
            }
        }
    </script>

