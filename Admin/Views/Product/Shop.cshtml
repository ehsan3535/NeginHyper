        </div>
        <div class="product-list__main">
            <div class="product-list__filter--container">
                <p class="product-list__filter-text">
                    <!-- <img src="../images/template/Icon-sort.svg" alt="sort-icon" /> -->
                    مرتب‌سازی براساس:
                </p>
                <a class="product-list__filter-text  mx-2 default__button" href="/Product/Shop?Type=1" style="cursor:pointer; text-align:center; align-items:center; justify-content:center; display:flex;">
                    آخرین محصولات
                </a>
                <a class="product-list__filter-text  mx-2 default__button" href="/Product/Shop?Type=2" style="cursor:pointer; text-align:center; align-items:center; justify-content:center;  display:flex;">
                    بیشترین امتیاز
                </a>
                <a class="product-list__filter-text mx-2 default__button" href="/Product/Shop?Type=4" style="cursor:pointer; text-align:center; align-items:center; justify-content:center;  display:flex;">
                    مناسب‌ترین قیمت
                </a>
            </div>
            <div class="product-list__filter--container d--mobile">
                <form method="get" asp-action="Shop" asp-controller="Product">
                    <select onchange="submitForm()" name="Type" class="product-list__sorting--mobile dropdown-sort">
                        <option disabled selected>مرتب‌سازی براساس</option>
                        <option value="1">آخرین محصولات</option>
                        <option value="2">بیشترین امتیاز</option>
                        <option value="4">مناسبترین قیمت</option>
                    </select>
                    <button id="gg" type="submit" hidden></button>
                </form>
                <div class="position-relative">
                    <!-- <img
                      class="product-list__filter_icon icon--filter"
                      src="../images/template/Icon-filter.svg"
                      alt="filter-icon"
                    /> -->
                    <form method="get" asp-action="Shop" asp-controller="Product">
                        <select onchange="submitForm2()" name="CategoryId" class="product-list__sorting--mobile dropdown-sort">
                            <option disabled selected>دسته بندی</option>
                            @foreach (var item in Model.First().Categories)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <button id="g" type="submit" hidden></button>
                    </form>
                </div>
            </div>
            <div class="filters--container">
                <div id="filter_selected--container"></div>
                <p class="filter_remove">حذف فیلتر ها</p>
            </div>
            <div class="product-list__card--container">
                @foreach (var item in Model)
                {
                    <div class="product-list__card">

                            <a href="/Product/ProductDetail_User?id=@item.Id"
                               class="product-list__card_a">
                                <img class="product-list__card_img"
                                     src="@item.ImageCoverUrl" />
                            </a>
                        <div class="product-list__card--content">
                            <a class="p-1 d-block"
                               href="/Product/ProductDetail_User?id=@item.Id">
                                <h3 class="product-list__card_h3">@item.Name</h3>
                            </a>
                            <div class="product-list__card--detail justify-content-center">
                                <span class="text-ceenter bg-primary-gradient px-2 py-1 br-20">
                                    <i class="fa fa-star m-2"> @item.Rate / 5</i>
                                </span>
                                @if (item.darage != 0)
                                {
                                <span class="text-ceenter bg-primary-gradient px-2 py-1 br-20">
                                        <span class="text-ceenter bg-primary-gradient px-2 py-1 br-20" style="text-align:center;">درجه @item.darage</span>
                                    </span>
                                }
                            </div>
                            @*<div class="product-list__badge--container"></div>*@
                            <div class="product-list__button-container">
                                @*href="/shopcard/AddOrRemove?ProductId=@item.Id&&AddOrRemove=true&&returnUrl=/Product/Shop"*@
                                <button type="button"
                                        onclick="shopShopCard('@item.Id')"
                                        class="product-list__card_button bg-success add-to-cart"
                                        data-name="برنج دورهمی  از محمد هادی غلامی"
                                        data-price="1180000"
                                        data-product="1283"
                                        data-type="1"
                                        name="">
                                    <i class="fa fa-plus " style="font-size: large;"></i>
                                </button>
                                @if (item.Count == 0)
                                {
                                    <p class="product-list__card_h3 h3--price h3--desktop">
                                        <span class="price_format"> نا موجود</span>
                                    </p>
                                }
                                else
                                {
                                          <p class="product-list__card_h3 h3--price h3--desktop">
                                    @if(item.Discount != item.Price)
                                    {
                                    <span class="price_format" style="text-decoration:line-through;color:red;">@item.Price.ToNumeric()</span> 
                                        
                                    }
                                                                           <span class="price_format">@item.Discount.ToNumeric()</span> تومان

                            </p>
                                    
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            @{
                int pageNumber = (int)TempData["Page"];
                int pageCount = (int)TempData["PageCount"];
            }
            <div class="row justify-content-center">
                <nav aria-label="Page navigation example">
                    <ul class="pagination justify-content-center">
                        @if ((pageNumber) > 1)
                        {
                            <li class="page-item">
                                <a class="page-link" href="Shop?Page=@(pageNumber-1)">قبلی</a>
                            </li>
                        }
                        @if ((pageNumber) > 3)
                        {
                            <li class="page-item"><a class="page-link" href="Shop?Page=@(pageNumber - 3)">@(pageNumber - 3)</a></li>
                        }
                        @if ((pageNumber) > 2)
                        {
                            <li class="page-item"><a class="page-link" href="Shop?Page=@(pageNumber - 2)">@(pageNumber - 2)</a></li>
                        }
                        @if ((pageNumber) > 1)
                        {
                            <li class="page-item"><a class="page-link" href="Shop?Page=@(pageNumber - 1)">@(pageNumber - 1)</a></li>
                        }
                        <li class="page-item disabled"><a class="page-link" href="#">@pageNumber</a></li>
                        @if ((pageNumber) < pageCount)
                        {
                            <li class="page-item"><a class="page-link" href="Shop?Page=@(pageNumber + 1)">@(pageNumber + 1)</a></li>
                        }
                        @if ((pageNumber) < pageCount - 1)
                        {
                            <li class="page-item"><a class="page-link" href="Shop?Page=@(pageNumber + 2)">@(pageNumber + 2)</a></li>
                        }
                        @if ((pageNumber) < pageCount - 2)
                        {
                            <li class="page-item"><a class="page-link" href="Shop?Page=@(pageNumber + 3)">@(pageNumber + 3)</a></li>
                        }

                        @if ((pageNumber) < pageCount)
                        {
                            <li class="page-item">
                                <a class="page-link" href="Shop?Page=@(pageNumber+1)" tabindex="-1">بعدی</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
            @if (TempData["CategoryId"] != null)
            {
                <div class="card bg-success p-5 mb-3">
                    <div class="row g-0">

							<div class="col-md-12   ">
								<div class="card-body">
									<h5 class="card-title">توضیحات دسته بندی @Model.First().CategorysName</h5>
									<p class="card-text">
									@Model.First().CategorysDescription
									</p>
								</div>
							</div>
						</div>
					</div>
			}
		</div>
	</div>
</div>

