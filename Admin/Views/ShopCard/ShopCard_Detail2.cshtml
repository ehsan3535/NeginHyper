@using Client.Models.ShopCards;
@model ShopCardDto

<div class="container my-3">


    <section class="progress-bar__section">

        <div class="progress-bar__item--container" style=" backdrop-filter: blur(20px);">
            <div class="progress-bar__item current">
                <div class="progress-bar__number">1</div>
                <a class="progress-bar__a">سبد خرید</span></a>
            </div>
            <div class="progress-bar__item current">
                <div class="progress-bar__number">2</div>
                <a class="progress-bar__a">مشخصات گیرنده</span></a>
            </div>
            <div class="progress-bar__item">
                <div class="progress-bar__number">3</div>
                <a class="progress-bar__a">بررسی نهایی</span></a>
            </div>
            <div class="progress-bar__item">
                <div class="progress-bar__number">4</div>
                <a class="progress-bar__a">پرداخت</span></a>
            </div>
        </div>
    </section>
    <form method="get" asp-action="ShopCard_Detail3" asp-controller="ShopCard">

        <div class="row">
            <div class="col-12 col-lg-9 col-md-12 col-sm-12">

                <section class="progress-bar__section px-5" style="max-height: 100px;">
                    <button type="button" class="text-success" data-bs-toggle="modal" data-bs-target="#modal-group"><h2>افزودن آدرس جدید +</h2></button>
                </section>



                <div class="card mx-3 br-20" dir="rtl">
                    <div class="card-body">
                        <div class="row w-100">
                            <div class="col-6 col-lg-4 col-md-4 col-sm-8">
                                <h6 class="card-title bg-info-gradient br-20 text-center">
                                    آدرس های پیشین
                                </h6>
                                @if (Model.Addresses.Any())
                                {
                                    <span>انتخاب کنید</span>
                                }
                                else
                                {
                                    <span>هنوز آدرسی ثبت نشده </span>
                                }
                            </div>
                        </div>
                        <div class="row justify-content-start">
                            @foreach (var item in Model.Addresses)
                            {
                                <div class="col-12 col-lg-6 col-md-6 col-sm-12 p-3">
                                    <label class="btn btn-outline-success w-100 my-3 no-hov" for="@item.Id">
                                        <input type="radio" class="" name="AddressId" id="@item.Id" value="@item.Id" autocomplete="off">

                                        <div class="card-body">
                                            <p class="card-text" style="text-align:start">
                                                <span class="weight-bold" style="font-weight:bold; font-size:24px;text-align:start;">
                                                    @item.Name
                                                </span>
                                                <br>
                                                <label class="form-check-label" for="@item.Id">
                                                    @item.CityName <br />@item.Location <br /> کدپستی: @item.PostalCode <br />واحد: @item.vahed <br /> پلاک : @item.pelak
                                                </label>
                                                <br>
                                                <div class="row justify-content-end">
                                                    <a class="text-danger" href="/shopCard/DeleteAddress?Id=@item.Id&ReturnUrl=/shopCard/shopcard_detail2">
                                                        حذف
                                                    </a>
                                                </div>

                                            </p>
                                        </div>
                                    </label>
                                </div>
                                @*
                            <div class="card">
                            <div class="card-header">
                            @item.Name
                            </div>
                            <div class="card-body">
                            <p class="card-text">
                            <input class="form-check-input" type="radio" name="AddressId" value="@item.Id" id="flexRadioDefault1">

                            <label class="form-check-label" for="flexRadioDefault1">
                            @item.Location
                            </label>
                            </p>
                            </div>
                            </div>*@
                                @*<div class="form-check my-2" dir="rtl">*@
                                @*<input class="form-check-input" type="radio" name="AddressId" value="@item.Id" id="flexRadioDefault1">*@
                                @*	<label class="form-check-label" for="flexRadioDefault1">
                            @item.Location
                            </label>*@
                                @*</div>*@
                            }
                        </div>



                    </div>
                </div>
            </div>
            <div class="col-12 col-lg-3 col-md-12 col-sm-12">

                <div class="card br-20">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-6">
                                <span class="card-title" style="font-weight: bold; font-size: large;">مبلغ کل</span>
                            </div>
                            <div class="col-6">
                                <span style=" font-size: medium;"> @Model.TotalPrice.ToNumeric() تومان</span>
                            </div>
                        </div>
                        <br>
                        <div class="row">
                            <div class="col-6">
                                <span class="card-title" style="font-weight: bold; font-size: large;">هزینه ارسال</span>
                            </div>
                            @if (Model.TotalPrice >= 500000)
                            {
                                <div class="col-6">
                                    <span style=" font-size: medium;">رایگان!</span>
                                </div>
                            }
                            else
                            {
                                <div class="col-6">
                                    <span style=" font-size: medium;"> @Model.PostPrice.ToNumeric() تومان</span>
                                </div>
                            }
                        </div>
                        <br>

                        <hr>
                        <br>

                        <div class="row">
                            <div class="col-6">
                                <span class="card-title" style="font-weight: bold; font-size: large;">مبلغ قابل پرداخت</span>
                            </div>
                            <div class="col-6">
                                <span class="text-success" style="font-weight: bold; font-size: medium;"> @Model.FinalTotalPrice.ToNumeric() تومان</span>
                            </div>
                        </div>
                        <br>
                        <button type="submit" class="btn bg-success w-100 py-4 br-20 " style="font-size:26px; border-radius:200px;text-align:center;">ادامه خرید</button>



                    </div>
                </div>
            </div>
        </div>
    </form>
</div>
<!-- ****************** moodal ****************-->
<!-- Modal -->

<div class="modal" id="modal-group" tabindex="-1" aria-labelledby="modal-groupLabel" aria-hidden="true" style="height:100% ; overflow-y:scroll !important;">
    <div class="modal-dialog modal-lg modal-scrollable modal-dialog-centered modal-dialog-scrollable" style="height:100% ; overflow-y:scroll !important  ">
        <div class="modal-content" style="height:100% ; overflow-y:scroll !important  ">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <!--
                          <h1 class="modal-title fs-5" id="modal-groupLabel">  سبد خرید شما تاکنون
                          </h1> -->
                <h1 class=" modal-title">
                    ثبت آدرس جدید
                </h1>
            </div>

            <form method="post" asp-action="AddAddress" asp-controller="ShopCard">

                <div class="modal-body w-100">

                    <div class="flex-column align-items-center justify-content-center w-100">
                        @*	<h2 class="centered-header">
                        ثبت آدرس جدید
                        </h2>
                        <br>*@
                        <div class="row w-100">

                            <div class="col-6 mb-4">
                                <div class="mb-0">
                                    <label class="required" style="margin-right:25px">استان* </label>
                                    <select dir="ltr" onchange="submitWithAjaxForm2()" name="ProvinceId" id="carTypeDropDown" style="height:50px" class="form-select form-control " aria-label="Default select example">
                                        <option value="0">انتخاب کنید</option>
                                        @foreach (var item in Model.Provinces)
                                        {
                                            <option value="@item.Id">@item.Name</option>

                                        }
                                    </select>
                                </div>
                            </div>
                            <div class="col-6 mb-4">
                                <div class="" id="carModel">
                                    <div class="mb-0">
                                        <label class="required" style="margin-right:25px">شهر *</label>
                                        <select dir="ltr" name="CityId" class="form-select form-control " style="height:50px" id="carModelDropDown" aria-label="Default select example">
                                            <option selected>انتخاب کنید </option>


                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 ">
                                <div class="form-group field-loginform-password required">


                                    <label class="control-label" for="loginform-password"> نشانی پستی</label>
                                    <input type="text"
                                           name="Location"
                                           id="Location"
                                           class="form-control py-4 w-100"
                                           aria-required="true" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group field-loginform-password required">

                                    <label class="control-label required" for="loginform-password">کد پستی </label>
                                    <input type="text"
                                           name="PostalCode"
                                           id="Name"
                                           maxlength="10"
                                           class="form-control py-4 w-100"
                                           aria-required="true" 
                                           required />
                                </div>
                            </div>


                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="form-group field-loginform-password ">

                                    <label class="control-label" for="">پلاک </label>
                                    <input type="text"
                                           name="Pelak"
                                           id=""
                                           class="form-control py-4 w-100"
                                           aria-required="true" />
                                </div>
                            </div>
                            <div class="col-lg-3 col-md-6 col-sm-6">
                                <div class="form-group field-loginform-password ">

                                    <label class="control-label" for="">واحد </label>
                                    <input type="text"
                                           name="vahed"
                                           id=""
                                           class="form-control py-4 w-100"
                                           aria-required="true" />
                                </div>
                            </div>
                            <hr />

                            <div class="col-6">
                                <div class="form-group field-loginform-password ">
                                    <label class="control-label" for="loginform-password"> نام و نام خانوادگی گیرنده</label>
                                    <input type="text"
                                           name="Name"
                                           id=""
                                           class="form-control py-4 w-100"
                                           aria-required="true" />
                                </div>
                            </div>
                        </div>


                        <div class="row justify-content-end">
                            <div class="form-group field-loginform-rememberme">
                                <div class="checkbox">
                                    <label for="loginform-rememberme">
                                        <input type="hidden"
                                               name="LoginForm[rememberMe]"
                                               value="0" /><input type="checkbox"
                                                                  id="loginform-rememberme"
                                                                  name="LoginForm[rememberMe]"
                                                                  value="1" />
                                        گیرند خودم نیستم
                                    </label>
                                    <p class="help-block help-block-error"></p>
                                </div>
                            </div>
                        </div>

                        @*<div class="form-group field-loginform-password required">


                        <label class="control-label" for="loginform-password">شماره تماس </label>
                        <input type="text"
                        name="PhoneNumber"
                        id="PhoneNumber"
                        class="form-control py-4 w-100"
                        aria-required="true" />
                        </div>*@


                        <p class="help-block help-block-error"></p>
                    </div>
                </div>


                <div class="modal-footer w-100" >
                    <div class="row w-100 justify-content-center">

                        <div class="col-6">
                            <button type="submit" class="mt-5 default__button button--medium ">ثبت و ادامه خرید  </button>

                        </div>
                        <br />
                    </div>
                </div>

            </form>


        </div>
    </div>
</div>

@section Scripts{
    <script>
        function submitForm2() {
            //document.getElementsByName("Shop").submit();
            document.getElementById("g").click();
        }

        function submitWithAjaxForm2() {
            var carTypeValue = $('#carTypeDropDown').find(":selected").val();

            $.ajax({
                type: "GET",
                url: "/ShopCard/Send_Cities",
                data: {
                    ProvinceId: carTypeValue,
                },
                success: function (result) {
                    $('#carModelDropDown').html("");
                    console.log(result);
                    for (var i = 0; i < result.length; i++) {
                        console.log(result[i]);

                        $('#carModelDropDown').append(`<option dir="ltr" value="${result[i].Id}"><span> ${result[i].Name} </span> </option>`);
                    }

                    $("#carModel").attr("hidden", false);
                },
                error: function (e) {
                    alert("error => " + e.responseText);
                }
            });
        }
    </script>

    <script>
        $(document).ready(function () {
            //// START PRODUCT PAGE
            if ($(".product-page").length) {
                $(".product_related .product_related_select").change(function () {
                    var id = $(this).children("option:selected").data("id");
                    var max = $(this).children("option:selected").data("max");
                    var price = $(this).children("option:selected").data("price");
                    $(".product_related .select").removeClass("select");
                    $(this).children("option:selected").addClass("select");
                    $(".add-to-cart").data("product", id);
                    $(".form-count input").val(1).attr("max", max);
                    $(".form-price-value span")
                        .text(formatPrice(price) + " تومان")
                        .data("fee", price);
                });

                var formatPrice = function formatPrice() {
                    var text =
                        arguments.length > 0 && arguments[0] !== undefined
                            ? arguments[0]
                            : "";
                    return (text + "")
                        .split("")
                        .reverse()
                        .reduce(function (tmp, char, i) {
                            tmp.push(i > 1 && i % 3 === 0 ? char + "," : char);
                            return tmp;
                        }, [])
                        .reverse()
                        .join("");
                };

                //make progress bar green by percent
                $.each($(".score_range--child"), function () {
                    var rangeWidth = parseInt($(this).data("range")) + "%";
                    $(this).css({ width: rangeWidth });
                });

                // $(".buy-num").change(function() {
                var changeFormCount = function changeFormCount(step) {
                    return function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var buyCount = $('[data-value="buy-count"]');
                        var priceDisplay = $("[data-fee]");
                        var count = parseInt(buyCount.val(), 10) + step;

                        if (count === 0) {
                            count = 1;
                        }

                        priceDisplay.text(
                            priceDisplay
                                .data("display")
                                .replace(
                                    /%price%/g,
                                    formatPrice(priceDisplay.data("fee") * count)
                                )
                        );
                        // buyCount.css({
                        //     width: count < 20 ? '16px' : '24px'
                        // });
                        buyCount.val(count);
                    };
                };
                // });

                var highlightActiveRadio = function highlightActiveRadio() {
                    var options = $(".form-option");
                    options.removeClass("checked");
                    options.each(function () {
                        if ($(this).find("input").prop("checked")) {
                            $(this).addClass("checked");
                        }
                    });
                };

                var changeTab = function changeTab(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(".tabs-trail [data-tab-action]").removeClass("active");
                    $(this).addClass("active");
                    $(".tab[data-tab]").removeClass("active");
                    $('[data-tab="'.concat($(this).data("tab-action"), '"]')).addClass(
                        "active"
                    );
                };

                $('[data-action="addCount"]').on("click", changeFormCount(1));
                $(".buy-num").on("change", changeFormCount(0));
                $('[data-action="subtractCount"]').on("click", changeFormCount(-1));
                $('.form-option input[type="radio"]').on(
                    "change",
                    highlightActiveRadio
                );
                $(".tabs .tabs-trail [data-tab-action]").on("click", changeTab);
                //$(".gallery-active").slick({
                //    slidesToShow: 1,
                //    slidesToScroll: 1,
                //    initialSlide: 0,
                //    autoplay: false,
                //    autoplaySpeed: 2000,
                //    pauseOnFocus: true,
                //    centerMode: false,
                //    arrows: true,
                //    asNavFor: ".gallery-thumbnails",
                //    draggable: false,
                //    swipe: false,
                //});
                //$(".gallery-thumbnails").slick({
                //    infinite: true,
                //    slidesToShow: 3,
                //    slidesToScroll: 1,
                //    pauseOnFocus: true,
                //    focusOnSelect: true,
                //    asNavFor: ".gallery-active",
                //    prevArrow: $(".prev-custom-arrow"),
                //    nextArrow: $(".next-custom-arrow"),
                //});
                $(".farmer-selector").click(function (e) {
                    e.preventDefault();
                    var commodity = $(this).data("type");
                    var id_product = $(this).data("id");
                    var url = $("head base").attr("href");
                    $.post(
                        url + "farmer/cart-farmers",
                        {
                            commodity: commodity,
                            id_product: id_product,
                        },
                        function (data, status) {
                            $(".alert-modal .modal-inner").html(data);
                            $(".alert-modal").modal("show");
                        }
                    );
                });
                $(".addCount").click(function (e) {
                    var $input = $(this).siblings("label").find("input");
                    var val = parseInt($input.val());
                    var max = $input.attr("max");
                    if (val > max) {
                        val = max;
                        alert(
                            "موجودی این محصول تنها " +
                            max +
                            " بسته می باشد.\nامکان خرید بیشتر نمی باشد."
                        );
                    }
                    $input.val(val);
                    var priceDisplay = $("[data-fee]");
                    priceDisplay.text(
                        priceDisplay
                            .data("display")
                            .replace(
                                /%price%/g,
                                formatPrice(priceDisplay.data("fee") * val)
                            )
                    );
                });
                $(".form-count input").change(function (e) {
                    // var type = $(this).data('type');
                    var max = $(this).attr("max");
                    var min = $(this).attr("min");
                    var val = parseInt($(this).val());
                    if (val > max) {
                        val = max;
                        alert(
                            "موجودی این محصول تنها " +
                            max +
                            " بسته می باشد.\nامکان خرید بیشتر نمی باشد."
                        );
                    }
                    if (val < min) val = min;
                    $(this).val(val);
                });
                $(".lab-reference").click(function (e) {
                    if ($('li[data-tab-action = "laboratory-result"]').length !== 0) {
                        e.preventDefault();
                        $('li[data-tab-action = "laboratory-result"]').addClass("active");
                        $('div[data-tab = "laboratory-result"]').addClass("active");
                        $('li[data-tab-action = "attributes-product"]').removeClass(
                            "active"
                        );
                        $('div[data-tab = "attributes-product"]').removeClass("active");
                        $('li[data-tab-action = "seller"]').removeClass("active");
                        $('div[data-tab = "seller"]').removeClass("active");
                        $("html, body").animate(
                            {
                                scrollTop:
                                    $('div[data-tab = "laboratory-result"] img').offset().top -
                                    250,
                            },
                            500
                        );
                    }
                });
                $(".identity-reference").click(function (e) {
                    $('li[data-tab-action = "attributes-product"]').addClass("active");
                    $('div[data-tab = "attributes-product"]').addClass("active");
                    $('li[data-tab-action = "seller"]').removeClass("active");
                    $('div[data-tab = "seller"]').removeClass("active");
                    $('li[data-tab-action = "laboratory-result"]').removeClass(
                        "active"
                    );
                    $('div[data-tab = "laboratory-result"]').removeClass("active");
                    $("html, body").animate(
                        {
                            scrollTop:
                                $('div[data-tab = "attributes-product"]').offset().top - 250,
                        },
                        500
                    );
                });
                // $('.pricing-transparency').click(function (e) {
                //     $('li[data-tab-action = "attributes-product"]').addClass('active');
                //     $('div[data-tab = "attributes-product"]').addClass('active');
                //     $('li[data-tab-action = "seller"]').removeClass('active');
                //     $('div[data-tab = "seller"]').removeClass('active');
                //     $('li[data-tab-action = "laboratory-result"]').removeClass('active');
                //     $('div[data-tab = "laboratory-result"]').removeClass('active');
                //     $('html, body').animate({
                //         scrollTop: $('div[data-tab = "attributes-product"] canvas').offset().top-250
                //     }, 500);
                // });

                //change like-image based on data-status(liked or not liked)
                var homeUrl = $("head base").attr("href");
                $('.comment_thumb_img[data-status="true"]').attr(
                    "src",
                    homeUrl + "images/template/thumbs-up@2xactive.png"
                );
                $('.comment_thumb_img[data-status="true"]').addClass("is-liked");
                $('.comment_thumb_img[data-status="false"]').attr(
                    "src",
                    homeUrl + "images/template/thumbs-up@2x.png"
                );
                $('.comment_thumb_img[data-status="false"]').removeClass("is-liked");

                $(".comment_thumb_img").on("click", function () {
                    if ($(".comment_thumb_a").data("link") === null) {
                        alert("لطفا برای ثبت نظر ابتدا وارد حساب کاربری شوید.");
                    } else {
                        var homeUrl = $("head base").attr("href");
                        var likes_count = $(this).parent().siblings(".comment_thumb_p");
                        var id_answer = $(this).parents(".review__comment").attr("id");
                        // change action based on data-status
                        var action = $(this).data("status") === false ? "like" : "clear";
                        if ($(this).data("status") === false) {
                            $(this).data("status", true);
                        } else {
                            $(this).data("status", false);
                        }
                        //showing some UI for liking a comment
                        $(this).toggleClass("is-liked");
                        if ($(this).hasClass("is-liked")) {
                            likes_count.html(parseInt(likes_count.html()) + 1);
                            $(this).attr(
                                "src",
                                homeUrl + "images/template/thumbs-up@2xactive.png"
                            );
                        } else {
                            likes_count.html(parseInt(likes_count.html()) - 1);
                            $(this).attr(
                                "src",
                                homeUrl + "images/template/thumbs-up@2x.png"
                            );
                        }
                        // ajax to send action type and id_answer
                        $.post(
                            homeUrl + "review/like",
                            {
                                id_answer: id_answer,
                                action: action,
                            },
                            function (data, status) {
                                $(this).data("status", data);
                            }
                        );
                    }
                });
            }
            //// END PRODUCT PAGE
        });
    </script>
    }
