@using Client.Models.ShopCards;
@model ShopCardDto

<div class="container my-3">

    @*<section class="progress-bar__section" style="background:url('/assets/images/bg/2.png'); background-position-y:bottom;background-repeat:no-repeat;background-size:cover;">*@
    <section class="progress-bar__section">

        <div class="progress-bar__item--container" style=" backdrop-filter: blur(20px);">
            <div class="progress-bar__item current">
                <div class="progress-bar__number">1</div>
                <a class="progress-bar__a">سبد خرید</span></a>
            </div>
            <div class="progress-bar__item">
                <div class="progress-bar__number">2</div>
                <a class="progress-bar__a">مشخصات گیرنده</span></a>
            </div>
            <div class="progress-bar__item">
                <div class="progress-bar__number">3</div>
                <a class="progress-bar__a">بررسی نهایی</span></a>
            </div>
            <div class="progress-bar__item">
                <div class="progress-bar__number">4</div>
                <a class="progress-bar__a">پرداخت</span></a>
            </div>
        </div>
    </section>
    <div class="row">
        <div class="col-12 col-lg-9 col-md-12 col-sm-12">
            @if (!Model.ShopCardDetails.Any())
            {
                <section class="progress-bar__section px-5" style="max-height: 100px;">
                    <h2>سبد خرید شما خالی هست</h2>
                </section>
            }

            @if (Model.ShopCardDetails.Any())
            {
                <div class="card-body">
                    <div class="card mx-3 br-20 ">
                        <div class="row w-100 py-4 px-3">
                            <div class="col-6 col-lg-4">
                                <h6 class="card-title bg-info-gradient br-20 text-center">
                                    محصولات سبد
                                </h6>
                            </div>
                            @*	<div class="col-6 col-lg-4">
                        <a href="Delete_All_ShopCard" class="card-title bg-danger-gradient br-20 text-center">
                        حذف سبد خرید
                        </a>
                        </div>*@
                        </div>
                        @foreach (var item in Model.ShopCardDetails)
                        {
                            <div class="card mb-3 bg-white mx-2 my-2" style="max-width: 100%; border:1px solid #d4d4d4; ">
                                <div class="row g-0">
                                    <div class="col-md-4">
                                        <img src="@item.ProductsImageLink" class="img-fluid rounded-start" alt="...">
                                    </div>
                                    <div class="col-md-8">
                                        <div class="card-body product">
                                            <h5 class="card-title">@item.ProductsName</h5>
                                            <div class="row info">
                                                <div class="form-price">
                                                    <div class="form-count">
                                                        @*	<a class="addCount form-count__button" href="/shopcard/AddOrRemove?ProductId=@item.ProductsId&AddOrRemove=true">
                                                <img src="/assets/media/icons/plus.png"
                                                alt="زیاد کردن تعداد" />
                                                </a>*@
                                                        <button class="subtractCount form-count__button" onclick="addToShopCard('@item.ProductsId')">
                                                            <img src="/assets/media/icons/plus.png"
                                                         alt="زیاد کردن تعداد" />
                                                        </button>
                                                        @*   @{
                                                if (item.ShopCartDeailCount < 1)
                                                {
                                                item.ShopCartDeailCount = 1;
                                                }
                                                item.Discount *= item.ShopCartDeailCount;
                                                }*@
                                                        <label>
                                                            <input class="buy-num"
                                                           type="number"
                                                           min="1"
                                                           max="10"
                                                           name="cart[num]"
                                                           data-type="1"
                                                           value="@item.Count"
                                                           data-value="buy-count" />
                                                            <span class="title">عدد</span>
                                                        </label>
                                                        @*                                                        <a class="subtractCount form-count__button" href="/shopcard/AddOrRemove?ProductId=@item.ProductsId&AddOrRemove=false">
                                                <img src="/assets/media/icons/minus.png"
                                                alt="کم کردن تعداد" />
                                                </a>*@
                                                        <button class="subtractCount form-count__button" onclick="removeFromShopCard('@item.ProductsId')">
                                                            <img src="/assets/media/icons/minus.png"
                                                         alt="کم کردن تعداد" />
                                                        </button>

                                                    </div>
                                                    @{
                                                        var TotalPrice = item.ProductsDiscount * item.Count;
                                                    }
                                                    <div class="form-price-value">
                                                        <span data-display="%price% تومان" data-fee="1">
                                                            @TotalPrice.ToNumeric() تومان
                                                        </span>
                                                    </div>
                                                </div>
                                                	<div class="row justify-content-start">
												<button type="button" style="margin-right:auto; text-align:left;" onclick="DeleteShopCarditem('@item.ProductsId')"><span style="margin-right:auto;text-align:left;" class="text-hover-danger"> حذف</span></button>

											</div>

                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>

                        }

                    </div>
                </div>
            }
        </div>

        <div class="col-12 col-lg-3 col-md-12 col-sm-12 ">
            <div class="card br-20">
                <div class="card-body">
                    <div class="row">
                        <div class="col-6">
                            <span class="card-title" style="font-weight: bold; font-size: large;">مبلغ کل</span>
                        </div>
                        <div class="col-6">
                            <span style=" font-size: medium;">  @Model.TotalPrice.ToNumeric() تومان</span>
                        </div>
                    </div>
                    <br>
                    <div class="row">
                        <div class="col-6">
                            <span class="card-title" style="font-weight: bold; font-size: large;">هزینه ارسال</span>
                        </div>
                        @if (Model.TotalPrice >= 500000)
                        {
                            <div class="col-6">
                                <span style=" font-size: medium;">رایگان!</span>
                            </div>
                        }
                        else
                        {
                            <div class="col-6">
                                <span style=" font-size: medium;"> @Model.PostPrice.ToNumeric() تومان</span>
                            </div>
                        }
                    </div>
                    <br>
                    <hr>
                    <br>
                    <div class="row">
                        <div class="col-6">
                            <span class="card-title" style="font-weight: bold; font-size: large;">مبلغ قابل پرداخت</span>
                        </div>
                        <div class="col-6">
                            <span class="text-success" style="font-weight: bold; font-size: medium;">@Model.FinalTotalPrice.ToNumeric() تومان</span>
                        </div>
                    </div>
                    <br>
                    @if (@Model.ShopCardDetails.Any())
                    {
                        if (User.Identity.IsAuthenticated)
                        {
                            <a href="/shopcard/ShopCard_Detail2" class="btn bg-success w-100 py-4 br-20 " style="font-size:26px; border-radius:200px;text-align:center;">ادامه خرید</a>
                        }
                        else
                        {
                            <a href="/auth/login?returnurl=/shopcard/ShopCard_Detail?clientid=@Model.ClientId" class="btn bg-success w-100 py-4 br-20 " style="font-size:26px; border-radius:200px;text-align:center;">ادامه خرید</a>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts{
    <script>
	function DeleteShopCarditem(p) {
		const clientId = document.cookie
			.split("; ")
			.find((row) => row.startsWith("guid"))
			?.split("=")[1];

			window.open(`/ShopCard/DeleteShopCardDetail?ProductId=${p}&ClientId=${clientId}`, "_self");

	}
</script>
    <script>
        function removeFromShopCard(e) {
            const clientId = document.cookie
                .split("; ")
                .find((row) => row.startsWith("guid"))
                ?.split("=")[1];
            var productId = e;
            //var buyCount = $('[data-value="buy-count"]').val();
            //console.log(buyCount);

            $.ajax({
                type: "GET",
                url: "/ShopCard/AddOrRemove",
                data: {
                    ClientId: clientId,
                    ProductId: productId,
                    Count: 0,
                    AddOrRemove: false,
                },
                success: function (result) {
                    if (result != "Bad") {
                        //window.open(result, "_self");
                        location.reload();
                    }
                },
                error: function (e) {
                    alert("error => " + e.responseText);
                }
            });

        }
        function addToShopCard(e) {
            const clientId = document.cookie
                .split("; ")
                .find((row) => row.startsWith("guid"))
                ?.split("=")[1];
            var productId = e;
            //var buyCount = $('[data-value="buy-count"]').val();
            //console.log(buyCount);

            $.ajax({
                type: "GET",
                url: "/ShopCard/AddOrRemove",
                data: {
                    ClientId: clientId,
                    ProductId: productId,
                    Count: 0,
                    AddOrRemove: true,
                },
                success: function (result) {
                    if (result != "Bad") {
                        //window.open(result, "_self");
                        location.reload();
                    }
                },
                error: function (e) {
                    alert("error => " + e.responseText);
                }
            });

        }
    </script>
    <script>
        $(document).ready(function () {
            //// START PRODUCT PAGE
            if ($(".product-page").length) {
                $(".product_related .product_related_select").change(function () {
                    var id = $(this).children("option:selected").data("id");
                    var max = $(this).children("option:selected").data("max");
                    var price = $(this).children("option:selected").data("price");
                    $(".product_related .select").removeClass("select");
                    $(this).children("option:selected").addClass("select");
                    $(".add-to-cart").data("product", id);
                    $(".form-count input").val(1).attr("max", max);
                    $(".form-price-value span")
                        .text(formatPrice(price) + " تومان")
                        .data("fee", price);
                });

                var formatPrice = function formatPrice() {
                    var text =
                        arguments.length > 0 && arguments[0] !== undefined
                            ? arguments[0]
                            : "";
                    return (text + "")
                        .split("")
                        .reverse()
                        .reduce(function (tmp, char, i) {
                            tmp.push(i > 1 && i % 3 === 0 ? char + "," : char);
                            return tmp;
                        }, [])
                        .reverse()
                        .join("");
                };

                //make progress bar green by percent
                $.each($(".score_range--child"), function () {
                    var rangeWidth = parseInt($(this).data("range")) + "%";
                    $(this).css({ width: rangeWidth });
                });

                // $(".buy-num").change(function() {
                var changeFormCount = function changeFormCount(step) {
                    return function (e) {
                        e.preventDefault();
                        e.stopPropagation();
                        var buyCount = $('[data-value="buy-count"]');
                        var priceDisplay = $("[data-fee]");
                        var count = parseInt(buyCount.val(), 10) + step;

                        if (count === 0) {
                            count = 1;
                        }

                        priceDisplay.text(
                            priceDisplay
                                .data("display")
                                .replace(
                                    /%price%/g,
                                    formatPrice(priceDisplay.data("fee") * count)
                                )
                        );
                        // buyCount.css({
                        //     width: count < 20 ? '16px' : '24px'
                        // });
                        buyCount.val(count);
                    };
                };
                // });

                var highlightActiveRadio = function highlightActiveRadio() {
                    var options = $(".form-option");
                    options.removeClass("checked");
                    options.each(function () {
                        if ($(this).find("input").prop("checked")) {
                            $(this).addClass("checked");
                        }
                    });
                };

                var changeTab = function changeTab(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $(".tabs-trail [data-tab-action]").removeClass("active");
                    $(this).addClass("active");
                    $(".tab[data-tab]").removeClass("active");
                    $('[data-tab="'.concat($(this).data("tab-action"), '"]')).addClass(
                        "active"
                    );
                };

                $('[data-action="addCount"]').on("click", changeFormCount(1));
                $(".buy-num").on("change", changeFormCount(0));
                $('[data-action="subtractCount"]').on("click", changeFormCount(-1));
                $('.form-option input[type="radio"]').on(
                    "change",
                    highlightActiveRadio
                );
                $(".tabs .tabs-trail [data-tab-action]").on("click", changeTab);
                //$(".gallery-active").slick({
                //    slidesToShow: 1,
                //    slidesToScroll: 1,
                //    initialSlide: 0,
                //    autoplay: false,
                //    autoplaySpeed: 2000,
                //    pauseOnFocus: true,
                //    centerMode: false,
                //    arrows: true,
                //    asNavFor: ".gallery-thumbnails",
                //    draggable: false,
                //    swipe: false,
                //});
                //$(".gallery-thumbnails").slick({
                //    infinite: true,
                //    slidesToShow: 3,
                //    slidesToScroll: 1,
                //    pauseOnFocus: true,
                //    focusOnSelect: true,
                //    asNavFor: ".gallery-active",
                //    prevArrow: $(".prev-custom-arrow"),
                //    nextArrow: $(".next-custom-arrow"),
                //});
                $(".farmer-selector").click(function (e) {
                    e.preventDefault();
                    var commodity = $(this).data("type");
                    var id_product = $(this).data("id");
                    var url = $("head base").attr("href");
                    $.post(
                        url + "farmer/cart-farmers",
                        {
                            commodity: commodity,
                            id_product: id_product,
                        },
                        function (data, status) {
                            $(".alert-modal .modal-inner").html(data);
                            $(".alert-modal").modal("show");
                        }
                    );
                });
                $(".addCount").click(function (e) {
                    var $input = $(this).siblings("label").find("input");
                    var val = parseInt($input.val());
                    var max = $input.attr("max");
                    if (val > max) {
                        val = max;
                        alert(
                            "موجودی این محصول تنها " +
                            max +
                            " بسته می باشد.\nامکان خرید بیشتر نمی باشد."
                        );
                    }
                    $input.val(val);
                    var priceDisplay = $("[data-fee]");
                    priceDisplay.text(
                        priceDisplay
                            .data("display")
                            .replace(
                                /%price%/g,
                                formatPrice(priceDisplay.data("fee") * val)
                            )
                    );
                });
                $(".form-count input").change(function (e) {
                    // var type = $(this).data('type');
                    var max = $(this).attr("max");
                    var min = $(this).attr("min");
                    var val = parseInt($(this).val());
                    if (val > max) {
                        val = max;
                        alert(
                            "موجودی این محصول تنها " +
                            max +
                            " بسته می باشد.\nامکان خرید بیشتر نمی باشد."
                        );
                    }
                    if (val < min) val = min;
                    $(this).val(val);
                });
                $(".lab-reference").click(function (e) {
                    if ($('li[data-tab-action = "laboratory-result"]').length !== 0) {
                        e.preventDefault();
                        $('li[data-tab-action = "laboratory-result"]').addClass("active");
                        $('div[data-tab = "laboratory-result"]').addClass("active");
                        $('li[data-tab-action = "attributes-product"]').removeClass(
                            "active"
                        );
                        $('div[data-tab = "attributes-product"]').removeClass("active");
                        $('li[data-tab-action = "seller"]').removeClass("active");
                        $('div[data-tab = "seller"]').removeClass("active");
                        $("html, body").animate(
                            {
                                scrollTop:
                                    $('div[data-tab = "laboratory-result"] img').offset().top -
                                    250,
                            },
                            500
                        );
                    }
                });
                $(".identity-reference").click(function (e) {
                    $('li[data-tab-action = "attributes-product"]').addClass("active");
                    $('div[data-tab = "attributes-product"]').addClass("active");
                    $('li[data-tab-action = "seller"]').removeClass("active");
                    $('div[data-tab = "seller"]').removeClass("active");
                    $('li[data-tab-action = "laboratory-result"]').removeClass(
                        "active"
                    );
                    $('div[data-tab = "laboratory-result"]').removeClass("active");
                    $("html, body").animate(
                        {
                            scrollTop:
                                $('div[data-tab = "attributes-product"]').offset().top - 250,
                        },
                        500
                    );
                });
                // $('.pricing-transparency').click(function (e) {
                //     $('li[data-tab-action = "attributes-product"]').addClass('active');
                //     $('div[data-tab = "attributes-product"]').addClass('active');
                //     $('li[data-tab-action = "seller"]').removeClass('active');
                //     $('div[data-tab = "seller"]').removeClass('active');
                //     $('li[data-tab-action = "laboratory-result"]').removeClass('active');
                //     $('div[data-tab = "laboratory-result"]').removeClass('active');
                //     $('html, body').animate({
                //         scrollTop: $('div[data-tab = "attributes-product"] canvas').offset().top-250
                //     }, 500);
                // });

                //change like-image based on data-status(liked or not liked)
                var homeUrl = $("head base").attr("href");
                $('.comment_thumb_img[data-status="true"]').attr(
                    "src",
                    homeUrl + "images/template/thumbs-up@2xactive.png"
                );
                $('.comment_thumb_img[data-status="true"]').addClass("is-liked");
                $('.comment_thumb_img[data-status="false"]').attr(
                    "src",
                    homeUrl + "images/template/thumbs-up@2x.png"
                );
                $('.comment_thumb_img[data-status="false"]').removeClass("is-liked");

                $(".comment_thumb_img").on("click", function () {
                    if ($(".comment_thumb_a").data("link") === null) {
                        alert("لطفا برای ثبت نظر ابتدا وارد حساب کاربری شوید.");
                    } else {
                        var homeUrl = $("head base").attr("href");
                        var likes_count = $(this).parent().siblings(".comment_thumb_p");
                        var id_answer = $(this).parents(".review__comment").attr("id");
                        // change action based on data-status
                        var action = $(this).data("status") === false ? "like" : "clear";
                        if ($(this).data("status") === false) {
                            $(this).data("status", true);
                        } else {
                            $(this).data("status", false);
                        }
                        //showing some UI for liking a comment
                        $(this).toggleClass("is-liked");
                        if ($(this).hasClass("is-liked")) {
                            likes_count.html(parseInt(likes_count.html()) + 1);
                            $(this).attr(
                                "src",
                                homeUrl + "images/template/thumbs-up@2xactive.png"
                            );
                        } else {
                            likes_count.html(parseInt(likes_count.html()) - 1);
                            $(this).attr(
                                "src",
                                homeUrl + "images/template/thumbs-up@2x.png"
                            );
                        }
                        // ajax to send action type and id_answer
                        $.post(
                            homeUrl + "review/like",
                            {
                                id_answer: id_answer,
                                action: action,
                            },
                            function (data, status) {
                                $(this).data("status", data);
                            }
                        );
                    }
                });
            }
            //// END PRODUCT PAGE
        });
    </script>

    }

