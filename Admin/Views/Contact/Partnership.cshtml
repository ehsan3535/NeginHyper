                    <div class="col-6" id="carModel" >
                        <div class="form-group rtl field-loginform-mobile required">
                            <label class="control-label" for="loginform-mobile"> شهر یا روستا  </label>
                            <select dir="ltr" name="CityId" class="form-select form-control " style="height:52px" id="carModelDropDown" aria-label="Default select example">
                                <option selected>انتخاب کنید </option>
                            </select>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="form-group rtl field-loginform-mobile ">
                            <label class="control-label" for="loginform-mobile"> سن  </label>
                            <input type="text"
                                   id="loginform-mobile"
                                   class="form-control py-4"
