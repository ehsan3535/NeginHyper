@using Client.Models.ProductDto;
@model List<ProductDto>

@section Styles{

    <style>
        html, body {
            overflow-x: hidden;
            background: #fff;
        }


        :root {
            --font-size: 1.1em;
            /*--bg1: #f5f8f7;*/
            --bg1: #fff;
            --blue: #0F9347;
            --green: #2ecc71;
            --purple: #f1c40f;
            --gold: orange;
            --red: #e74c3c;
            --orange: #e67e22;
            --shadow1: 0 2px 4px #00000026, 0 3px 6px #0000001f;
            --shadow2: 0 2px 6px #00000044, 0 4px 7px #00000022;
        }

        .info-graph {
            padding: 2vw;
        }

            .info-graph ul.infoGraphic {
                font-size: var(--font-size);
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
            }

                .info-graph ul.infoGraphic li {
                    position: relative;
                    width: 100%;
                    max-width: 25em;
                    background: var(--bg1);
                    border-radius: 0.5em;
                    padding: 0.5em;
                    z-index: 1;
                    transition: all 0.2s;
                    cursor: pointer;
                }

                    .info-graph ul.infoGraphic li .numberWrap {
                        position: absolute;
                    }

                    .info-graph ul.infoGraphic li .number {
                        font-family: "maven pro", sans-serif;
                        font-size: 13em;
                        font-weight: 900;
                        width: 0.9em;
                        text-align: center;
                    }

                        .info-graph ul.infoGraphic li .number.fontColor1 {
                            color: var(--blue);
                        }

                        .info-graph ul.infoGraphic li .number.fontColor2 {
                            color: var(--green);
                        }

                        .info-graph ul.infoGraphic li .number.fontColor3 {
                            color: var(--purple);
                        }

                        .info-graph ul.infoGraphic li .number.fontColor4 {
                            color: var(--gold);
                        }

                        .info-graph ul.infoGraphic li .number.fontColor5 {
                            color: var(--red);
                        }

                        .info-graph ul.infoGraphic li .number.fontColor6 {
                            color: var(--orange);
                        }

                    .info-graph ul.infoGraphic li .coverWrap {
                        transform: rotate(130deg);
                        position: absolute;
                        width: 18em;
                        height: 15em;
                        left: -3em;
                        top: -1em;
                    }

        ul.infoGraphic li .coverWrap .numberCover {
            position: absolute;
            background: var(--bg1);
            width: 18em;
            height: 6em;
            border-radius: 50% 50% 0 0;
            border-bottom: 3px solid #f5f8f7;
            transition: all 0.4s;
        }

        .info-graph ul.infoGraphic li .coverWrap .numberCover::before {
            position: absolute;
            content: "";
            bottom: 5px;
            left: 4em;
            right: 4em;
            top: 5em;
            box-shadow: 0 0 30px 17px #48668577;
            border-radius: 100px/10px;
            z-index: -1;
        }

        .info-graph ul.infoGraphic li .coverWrap .numberCover::after {
            position: absolute;
            bottom: 0;
            content: "";
            left: -10%;
            width: 120%;
            height: 150%;
            background: radial-gradient(at bottom, #48668533, transparent, transparent);
            z-index: 1;
        }

        .info-graph ul.infoGraphic li .content {
            margin: 8em 3em 1em 7em;
            position: relative;
        }

            .info-graph ul.infoGraphic li .content h2 {
                font-size: 1.7em;
                font-weight: 500;
                text-align: center;
                margin-bottom: 10px;
                text-transform: uppercase;
            }

            .info-graph ul.infoGraphic li .content p {
                line-height: 1.5em;
            }

        .info-graph ul.infoGraphic li:hover .coverWrap .numberCover {
            border-radius: 100%;
        }

        .info-graph .icon {
            position: absolute;
            font-size: 2rem;
            text-align: center;
            top: -1.3em;
            left: 50%;
            transform: translatex(-50%);
        }

            .info-graph .icon:before {
                color: #666;
                font-family: FontAwesome;
                font-style: normal;
                font-weight: normal;
                text-decoration: inherit;
            }

        .info-graph .iconCodepen:before {
            content: "";
        }

        .info-graph .iconSocial:before {
            content: "";
        }

        .info-graph .iconAirplane:before {
            content: "";
        }

        .info-graph .iconMap:before {
            content: "";
        }

        .info-graph .iconBulb:before {
            content: "";
        }

        .info-graph .iconPeace:before {
            content: "";
        }

        .content p {
            text-align: right !important;
        }

    </style>

}

<div id="carouselExampleCaptions" class="carousel slide">
    <div class="carousel-indicators">
        <button type="button"
                data-bs-target="#carouselExampleCaptions"
                data-bs-slide-to="0"
                class="active"
                aria-current="true"
                aria-label="Slide 1"></button>
        <button type="button"
                data-bs-target="#carouselExampleCaptions"
                data-bs-slide-to="1"
                aria-label="Slide 2"></button>
        <button type="button"
                data-bs-target="#carouselExampleCaptions"
                data-bs-slide-to="2"
                aria-label="Slide 3"></button>
    </div>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <a href="@Model.First().SettingDto.TopImageLink1">
                <img loading="lazy" src="@Model.First().SettingDto.TopImageLink1"
                     class="d-block w-100"
                     alt="..."
                     style="max-height: 70vh" />
            </a>
        </div>
        <div class="carousel-item">
            <a href="@Model.First().SettingDto.TopImageLink2">
                <img loading="lazy" src="@Model.First().SettingDto.TopImageLink2"
                     class="d-block w-100"
                     alt="..."
                     style="max-height: 70vh" />
            </a>
        </div>
        <div class="carousel-item">
            <a href="@Model.First().SettingDto.TopImageLink3">
                <img loading="lazy" src="@Model.First().SettingDto.TopImageLink3"
                     class="d-block w-100"
                     alt="..."
                     style="max-height: 70vh" />
            </a>
        </div>
    </div>
    <button class="carousel-control-prev my-prev"
            type="button"
            data-bs-target="#carouselExampleCaptions"
            data-bs-slide="prev">
        <span class="carousel-control-prev-icon" style="background:#fff; color:#000 !important; border-radius:200px;   width:50px; height:50px; padding:1vw; display:flex; align-content:center; justify-content:center; align-items:center" aria-hidden="true"><i class="fa fa-angle-left"></i></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next my-next"
            type="button"
            data-bs-target="#carouselExampleCaptions"
            data-bs-slide="next">
        <span class="carousel-control-next-icon" style="background:#fff; color:#000 !important;  border-radius:200px;   width:50px; height:50px; padding:1vw; display:flex; align-content:center; justify-content:center; align-items:center" aria-hidden="true"><i class="fa fa-angle-right"></i></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

