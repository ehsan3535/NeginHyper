                                           id="Location"
                                           class="form-control py-4 w-100"
                                           aria-required="true" />
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="form-group field-loginform-password required">

                                    <label class="control-label" for="loginform-password">کد پستی </label>
                                    <input type="text"
                                           name="PostalCode"
                                           id="Name"
                                           maxlength="10"
                                           class="form-control py-4 w-100"
                                           aria-required="true" 
                                           required/>
                                </div>
                            </div>


                            <div class="col-6 pe-4">
                                <div class="row w-100 pe-1">
                                    <div class="col-6">
                                        <div class="form-group field-loginform-password required">

                                            <label class="control-label" for="">پلاک </label>
                                            <input type="text"
                                                   name="Pelak"
                                                   id=""
                                                   class="form-control py-4 w-100"
                                                   aria-required="true" />
                                        </div>
                                    </div>
                                    <div class="col-6">
                                        <div class="form-group field-loginform-password ">

                                            <label class="control-label" for="">واحد </label>
                                            <input type="text"
                                                   name="vahed"
                                                   id=""
                                                   class="form-control py-4 w-100"
                                                   aria-required="true" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-6">
                            </div>

                            <div class="col-6">
                                <div class="form-group field-loginform-password ">


                                    <label class="control-label" for="loginform-password"> نام و نام خانوادگی گیرنده</label>
                                    <input type="text"
                                           name="Name"
                                           id=""
                                           class="form-control py-4 w-100"
                                           aria-required="true" />
                                </div>
                            </div>  <div class="col-6">
                            </div>


                        </div>

                        @*<div class="form-group field-loginform-password required">


                        <label class="control-label" for="loginform-password">شماره تماس </label>
                        <input type="text"
                        name="PhoneNumber"
                        id="PhoneNumber"
                        class="form-control py-4 w-100"
                        aria-required="true" />
                        </div>*@


                        <p class="help-block help-block-error"></p>
                    </div>
                </div>

                <div class="modal-footer w-100">
                    <div class="row w-100">
                        <div class="col-6">
                            <button type="button" class="btn bg-danger-bright w-100 br-20 p-2 py-3" data-bs-dismiss="modal"> لغو</button>
                        </div>
                        <div class="col-6">
                            <button type="submit" class="btn bg-success w-100 br-20 p-2 py-3">ثبت  </button>

                        </div>
                        <br />
                    </div>

                </div>

            </form>
        </div>
    </div>
</div>

