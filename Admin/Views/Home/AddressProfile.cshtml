<!-- Modal -->
<div class="modal" id="modal-group" tabindex="-1" aria-labelledby="modal-groupLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-scrollable modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                <!--
                          <h1 class="modal-title fs-5" id="modal-groupLabel">  سبد خرید شما تاکنون
                          </h1> -->
                <h1 class=" modal-title">
                    ثبت آدرس جدید
                </h1>
            </div>

            <form method="post" asp-action="AddAddress" asp-controller="ShopCard">

                <div class="modal-body w-100">
